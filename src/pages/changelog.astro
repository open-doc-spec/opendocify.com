---
// FILE: changelog.astro
// Purpose: Release changelog page for ODS.
// Layer: Marketing page

import Layout from "../layouts/Layout.astro";
import HeroGradient from "../components/HeroGradient.astro";
import { REPO_URL } from "../lib/releases";
import { changelog } from "../data/changelog";

function withInlineCode(text: string) {
  return text.split(/(`[^`]+`)/g).map((part) => {
    if (part.startsWith("`") && part.endsWith("`")) {
      return { code: true, value: part.slice(1, -1) };
    }
    return { code: false, value: part };
  });
}
---

<Layout title="Changelog: Open Document Spec (ODS)" activeNav="changelog">
  <!-- FULL-WIDTH END-TO-END HERO SECTION -->
  <section class="changelog-hero-wrapper">
    <!-- TOP ETHEREAL 2-COLOR GRADIENT BLUR BACKDROP -->
    <HeroGradient />

    <div class="header-section">
      <h1 class="page-title">Changelog</h1>
      <p class="page-subtitle">
        What changed in the <code>ods</code> command — so you know what to type, what to fix in your files, and when to update.
      </p>
    </div>
  </section>

  <div class="page-container">
    <div class="timeline">
      {changelog.map((entry) => (
        <article class="timeline-item">
          <div class="timeline-meta">
            <span class="version-tag">{entry.tag}</span>
            {entry.latest && <span class="latest-tag">Latest</span>}
            <span class="date">{entry.date}</span>
          </div>
          <div class="timeline-content">
            <h2>
              {withInlineCode(entry.title).map((part) => (part.code ? <code>{part.value}</code> : part.value))}
            </h2>
            <p>
              {withInlineCode(entry.summary).map((part) => (part.code ? <code>{part.value}</code> : part.value))}
            </p>
            <ul>
              {entry.items.map((item) => (
                <li>
                  <strong>{item.label}</strong>
                  {': '}
                  {withInlineCode(item.text).map((part) => (part.code ? <code>{part.value}</code> : part.value))}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="changelog-cta">
      <p class="changelog-note">
        Sourced from the <code>ods</code> engine changelog. GitHub still has every tag, including internal CI builds.
      </p>
      <a href={`${REPO_URL}/releases`} target="_blank" rel="noopener noreferrer" class="cta-button">
        Download a release →
      </a>
    </div>
  </div>
</Layout>

<style>
  .changelog-hero-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .page-container {
    width: min(92vw, 900px);
    margin: 0 auto;
    padding-top: var(--space-16);
    padding-bottom: var(--space-64);
    position: relative;
    z-index: 1;
  }

  .header-section {
    text-align: center;
    max-width: 800px;
    width: min(92vw, 800px);
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    font-weight: 650;
    padding: 6px 16px;
    background: var(--color-surface, var(--card-bg));
    border: 1px solid var(--color-border, var(--border));
    border-radius: var(--radius-pill);
    color: var(--color-text-muted, var(--fg-muted));
    margin-bottom: var(--space-16);
    box-shadow: var(--shadow-sm);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .page-title {
    font-size: clamp(2.4rem, 5.2vw, 3.4rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.032em;
    margin-bottom: var(--space-16);
    color: var(--fg);
  }

  .page-subtitle {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--fg-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .timeline {
    border-left: var(--border);
    padding-left: var(--space-32);
    margin-left: var(--space-16);
    margin-bottom: var(--space-64);
    position: relative;
    z-index: 2;
  }

  .timeline-item {
    position: relative;
    margin-bottom: var(--space-48);
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: calc(-2rem - 5px);
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--fg);
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  .version-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    padding: var(--space-4) var(--space-8);
    background: var(--action-bg);
    color: var(--action-fg);
    border-radius: var(--radius-sm);
  }

  .latest-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-sm);
    background: var(--ods-accent-soft, #e6f4ea);
    color: #15803d;
  }

  .date {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .timeline-content h2 {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: var(--space-8);
  }

  .timeline-content h2 code,
  .page-subtitle code,
  .timeline-content p code,
  .timeline-content li code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .header-section .page-subtitle code {
    font-size: 0.95em;
  }

  .timeline-content p {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin-bottom: var(--space-16);
  }

  .timeline-content ul {
    list-style-type: disc;
    padding-left: var(--space-24);
  }

  .timeline-content li {
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin-bottom: var(--space-8);
    line-height: 1.5;
  }

  .timeline-content li strong {
    color: var(--fg);
  }

  .changelog-cta {
    text-align: center;
  }

  .changelog-note {
    max-width: 36rem;
    margin: 0 auto var(--space-16);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    padding: var(--space-12) var(--space-24);
    background: var(--action-bg);
    color: var(--action-fg);
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    transition: opacity 0.2s ease;
  }

  .cta-button:hover {
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .page-container {
      width: 100% !important;
      max-width: 100% !important;
      padding: var(--space-16) 1rem var(--space-64) 1rem !important;
      box-sizing: border-box !important;
    }
    .header-section {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    .timeline {
      margin-left: 8px;
      padding-left: 18px;
      width: 100%;
      box-sizing: border-box;
    }
    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-12);
      width: 100%;
      box-sizing: border-box;
    }
    .timeline-item::before {
      left: calc(-1.125rem - 4.5px);
    }
    .timeline-meta {
      flex-direction: row;
      align-items: center;
      gap: var(--space-8);
      flex-wrap: wrap;
    }
    .timeline-content {
      width: 100%;
      box-sizing: border-box;
    }
    .main {
      padding: var(--space-32) var(--space-16) var(--space-48);
    }
  }
</style>
