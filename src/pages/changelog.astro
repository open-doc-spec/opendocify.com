---
import Layout from "../layouts/Layout.astro";
import { REPO_URL } from "../lib/releases";
---

<Layout title="Changelog — Open Document Spec (ODS)" activeNav="changelog">
  <section class="page-hero"><div class="container"><div class="section-header"><span class="eyebrow">Release history</span><h1>What is changing in ODS.</h1><p class="lead">Follow the specification, CLI, and integration work as the document graph becomes more useful across teams.</p></div></div></section>
  <section class="section"><div class="container-narrow"><div class="timeline"><article class="timeline-item"><div class="timeline-meta"><span class="tag">v0.1.0</span><span class="subtle">Initial release</span></div><div class="timeline-content"><h2>Open Document Spec core</h2><p>Initial release of the ODS specification, native Rust CLI, and AI context tooling.</p><ul><li>Rust-native <code>ods</code> binary for linting, indexing, and context extraction.</li><li>Level 0–3 adoption model with <code>ods:</code> frontmatter and dependency graphs.</li><li>Deterministic <code>ods context &lt;path&gt;</code> reading lists.</li><li>Background watch mode for file moves and link repair.</li><li>AI integrations for Claude Code, Cursor, Windsurf, and more.</li></ul></div></article></div><div style="margin-top: 3rem;"><a class="button button-primary" href={`${REPO_URL}/releases`} target="_blank" rel="noopener noreferrer">View full release logs ↗</a></div></div></section>
</Layout>
