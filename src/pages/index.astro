  /* ── Panel 2: Interactive Terminal Styling ── */
  .cli-wrap-inner {
    background: #09090b !important;
    text-align: left !important;
  }

  .cli-header {
    background: #141417 !important;
    border-bottom: 1px solid #27272a !important;
    padding: 11px 18px !important;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cli-dots {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .cli-dots .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .cli-dots .dot.red { background: #ff5f56 !important; }
  .cli-dots .dot.yellow { background: #ffbd2e !important; }
  .cli-dots .dot.green { background: #27c93f !important; }

  .cli-title-group {
    display: flex;
