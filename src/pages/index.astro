          install: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods install</span></span>\n<span class="t-success">✓ Installing ODS...</span>\n<span class="t-success">✓ Reading list enabled</span>\n<span class="t-success">✓ Connected to your AI assistant</span>\n<span class="t-success">✓ Ready to go!</span>\n<hr class="t-hr"/>\n<span class="t-next">&gt; Ask your AI anything.</span>',
          query: '<span class="t-cmd-line"><span class="t-prompt">&gt;</span> <span class="t-cmd">/ods context</span> <span class="t-arg">specs/ods/intro.md</span></span>\n<span class="t-success">✓ Scanned document connections in 2.8ms</span>\n<span class="t-success">✓ Loaded reading list: 3 files, 4,120 tokens (saves 94.97% AI costs)</span>\n<span class="t-json">├── specs/ods/intro.md (Main page)</span>\n<span class="t-json">├── docs/guide/01-introduction.md (linked page)</span>\n<span class="t-json">└── src/crates/ods-core/src/graph.rs (connected code)</span>',
          mcp: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">mcp enable</span> <span class="t-flag">--assistant</span> <span class="t-arg">claude</span></span>\n<span class="t-success">✓ Added ODS MCP Server to ~/.claude/claude_desktop_config.json</span>\n<span class="t-success">✓ Tools available: ods_get_context, ods_verify_graph, ods_list_deps</span>'
        }
      },
      cursor: {
        mode: "Rules Integration",
        data: {
          install: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">skill install</span> <span class="t-flag">--target</span> <span class="t-arg">cursor</span></span>\n<span class="t-success">✓ Added .cursor/rules/ods.mdc to workspace</span>\n<span class="t-success">✓ Reading labeled document connections...</span>\n<span class="t-next">&gt; Ask Cursor Composer: <span class="t-arg">"How does the ODS graph work?"</span></span>',
          query: '<span class="t-cmd-line"><span class="t-prompt">&gt;</span> <span class="t-cmd">@ods context</span> <span class="t-arg">docs/architecture.md</span></span>\n<span class="t-success">✓ Reading list attached to prompt window</span>\n<span class="t-success">✓ Injected 4 related pages (&lt; 3,800 tokens total)</span>',
          mcp: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">mcp generate-config</span> <span class="t-flag">--format</span> <span class="t-arg">cursor</span></span>\n<span class="t-comment"># Copy to Cursor Settings -&gt; Features -&gt; MCP Servers:</span>\n<span class="t-json">Name: ODS Graph Engine</span>\n<span class="t-json">Command: ods</span>\n<span class="t-json">Args: mcp serve</span>'
        }
      },
      copilot: {
        mode: "Workspace Skill",
        data: {
          install: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">skill install</span> <span class="t-flag">--target</span> <span class="t-arg">copilot</span></span>\n<span class="t-success">✓ Configured GitHub Copilot workspace agent skill (.github/copilot-instructions.md)</span>',
          query: '<span class="t-cmd-line"><span class="t-prompt">&gt;</span> <span class="t-cmd">@copilot /ods context</span> <span class="t-arg">guide/02-frontmatter.md</span></span>\n<span class="t-success">✓ Built smart reading list in 3.1ms</span>',
          mcp: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">mcp serve</span> <span class="t-flag">--port</span> <span class="t-arg">8080</span></span>\n<span class="t-success">✓ ODS MCP Server listening on localhost:8080 for GitHub Copilot Workspace</span>'
        }
      },
      antigravity: {
        mode: "Built-in Skill",
        data: {
          install: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">skill install</span> <span class="t-flag">--target</span> <span class="t-arg">antigravity</span></span>\n<span class="t-success">✓ Installed ODS skill to ~/.gemini/config/skills/ods/SKILL.md</span>\n<span class="t-success">✓ Direct terminal execution enabled</span>\n<span class="t-next">&gt; Ask Antigravity: <span class="t-arg">"Audit doc graph references"</span></span>',
          query: '<span class="t-cmd-line"><span class="t-prompt">&gt;</span> <span class="t-cmd">/ods context</span> <span class="t-arg">specs/ods/intro.md</span></span>\n<span class="t-success">✓ Document scan completed in 1.9ms</span>\n<span class="t-success">✓ Smart reading list injected into prompt window</span>',
          mcp: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">mcp enable</span> <span class="t-flag">--target</span> <span class="t-arg">antigravity</span></span>\n<span class="t-success">✓ Added ODS server entry to Antigravity MCP registry</span>'
        }
      },
      gemini: {
        mode: "CLI Extension",
        data: {
          install: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">skill install</span> <span class="t-flag">--target</span> <span class="t-arg">gemini-cli</span></span>\n<span class="t-success">✓ Added ODS extension to Gemini CLI environment</span>\n<span class="t-next">&gt; Type <span class="t-arg">"gemini --ods"</span> in terminal</span>',
          query: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">gemini</span> <span class="t-flag">--ods-context</span> <span class="t-arg">docs/guide/01-introduction.md</span></span>\n<span class="t-success">✓ Loaded 3 linked pages into Gemini prompt context</span>',
          mcp: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">mcp serve</span> <span class="t-flag">--stdio</span></span>\n<span class="t-success">✓ Connecting stdio transport for Gemini CLI...</span>'
        }
      },
      windsurf: {
        mode: "Terminal Hook",
        data: {
          install: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">skill install</span> <span class="t-flag">--target</span> <span class="t-arg">windsurf</span></span>\n<span class="t-success">✓ Windsurf Cascade flow hook registered</span>\n<span class="t-success">✓ Prevents Windsurf from reading unrelated project files</span>\n<span class="t-next">&gt; Flow hook active for all workspace prompts</span>',
          query: '<span class="t-cmd-line"><span class="t-prompt">&gt;</span> <span class="t-cmd">ods context</span> <span class="t-arg">in flow hooks</span></span>\n<span class="t-success">✓ Auto-injected linked documentation context</span>\n<span class="t-success">✓ Reduced word count by 94.97%</span>',
          mcp: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">mcp generate-config</span> <span class="t-flag">--format</span> <span class="t-arg">windsurf</span></span>\n<span class="t-success">✓ Configured Windsurf MCP provider</span>'
        }
      },
      openai: {
        mode: "MCP Connector",
        data: {
          install: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">mcp enable</span> <span class="t-flag">--target</span> <span class="t-arg">openai</span></span>\n<span class="t-success">✓ ODS MCP Server registered for OpenAI / Codex tools</span>\n<span class="t-success">✓ Drastically reduces prompt tokens on large code bases</span>',
          query: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">graph</span> <span class="t-flag">--format</span> <span class="t-arg">json</span></span>\n<span class="t-success">✓ Exported JSON document graph for GPT context window</span>',
          mcp: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">mcp serve</span> <span class="t-flag">--stdio</span></span>\n<span class="t-success">✓ Listening on stdio for OpenAI tool calling</span>'
        }
      },
      aider: {
        mode: "Pre-Hook",
        data: {
          install: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">install</span> <span class="t-flag">--aider</span></span>\n<span class="t-success">✓ Created .aider.conf.yml with ODS graph context pre-hook</span>',
          query: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">aider</span> <span class="t-flag">--read</span> <span class="t-arg">docs/guide/01-introduction.md</span> <span class="t-flag">--ods-graph</span></span>\n<span class="t-success">✓ Autoloaded linked document pages</span>',
          mcp: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">mcp serve</span></span>\n<span class="t-success">✓ Aider MCP interface ready</span>'
        }
      },
      cargo: {
        mode: "Direct CLI Binary",
        data: {
          install: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">cargo</span> <span class="t-sub">install</span> <span class="t-arg">ods</span></span>\n<span class="t-comment"># Or via 1-line shell script:</span>\n<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">curl</span> <span class="t-flag">-fsSL</span> <span class="t-arg">https://opendocify.com/install.sh</span> | <span class="t-cmd">bash</span></span>\n<span class="t-success">✓ Installed ods v0.1.0 to /usr/local/bin/ods</span>',
          query: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">context</span> <span class="t-arg">docs/guide/01-introduction.md</span> <span class="t-flag">--format</span> <span class="t-arg">json</span></span>\n<span class="t-json">{</span>\n<span class="t-json">&nbsp;&nbsp;<span class="t-arg">"root"</span>: <span class="t-sub">"docs/guide/01-introduction.md"</span>,</span>\n<span class="t-json">&nbsp;&nbsp;<span class="t-arg">"cost_savings_pct"</span>: <span class="t-flag">94.97</span>,</span>\n<span class="t-json">&nbsp;&nbsp;<span class="t-arg">"nodes"</span>: [<span class="t-sub">"specs/ods/intro.md"</span>, <span class="t-sub">"src/crates/ods-core/src/graph.rs"</span>]</span>\n<span class="t-json">}</span>',
          mcp: '<span class="t-cmd-line"><span class="t-prompt">$</span> <span class="t-cmd">ods</span> <span class="t-sub">serve</span> <span class="t-flag">--daemon</span></span>\n<span class="t-success">✓ Smart background link repair started (pid 84210)</span>\n<span class="t-success">✓ Automatically repairing links and checking for errors</span>'
        }
      }
    };

    let activeAssistant = 'claude';
    let activeTab = 'install';

    const astButtons = document.querySelectorAll('.assistant-btn');
    const termTabs = document.querySelectorAll('.term-tab');
    const codeBlock = document.getElementById('ast-code-block');
    const modeBadge = document.getElementById('integration-mode-badge');
    const copyBtn = document.getElementById('copy-ast-btn');
    const copyText = document.getElementById('copy-ast-text');
    const copyIcon = copyBtn?.querySelector('.copy-icon') as HTMLElement | null;
    const checkIcon = copyBtn?.querySelector('.check-icon') as HTMLElement | null;

    function updateTerminal() {
      if (!codeBlock) return;
      codeBlock.classList.add('fade-out');
      if (modeBadge) {
        modeBadge.textContent = assistantMetadata[activeAssistant]?.mode || 'AI Skill';
      }
      setTimeout(() => {
        const snippet = assistantMetadata[activeAssistant]?.data?.[activeTab] || '';
        codeBlock.innerHTML = snippet + '<span class="t-cursor"></span>';
        codeBlock.classList.remove('fade-out');
      }, 80);
    }

    astButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        astButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        activeAssistant = btn.getAttribute('data-assistant') || 'claude';
        updateTerminal();
      });
    });

    termTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        termTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        activeTab = tab.getAttribute('data-tab') || 'install';
        updateTerminal();
      });
    });

    if (copyBtn && codeBlock) {
      copyBtn.addEventListener('click', () => {
        const cmdLines = Array.from(codeBlock.querySelectorAll('.t-cmd-line'));
        let cleanText = '';
        if (cmdLines.length > 0) {
          cleanText = cmdLines
            .map((lineEl) => {
              const clone = lineEl.cloneNode(true) as HTMLElement;
              clone.querySelectorAll('.t-prompt').forEach((prompt) => prompt.remove());
              return (clone.textContent || '').trim();
            })
            .filter(Boolean)
            .join('\n');
        } else {
          cleanText = codeBlock.innerText || codeBlock.textContent || '';
        }
        navigator.clipboard.writeText(cleanText.trim());
        
        copyBtn.classList.add('copied');
        if (copyText) copyText.textContent = 'Copied!';
        if (copyIcon) copyIcon.style.display = 'none';
        if (checkIcon) checkIcon.style.display = 'inline-block';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          if (copyText) copyText.textContent = 'Copy';
          if (copyIcon) copyIcon.style.display = 'inline-block';
          if (checkIcon) checkIcon.style.display = 'none';
        }, 2000);
      });
    }

    document.querySelectorAll('.step-copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const codeText = btn.getAttribute('data-code') || '';
        if (!codeText) return;
        navigator.clipboard.writeText(codeText);
        const copyText = btn.querySelector('.copy-text') as HTMLElement | null;
        const copyIcon = btn.querySelector('.copy-icon') as HTMLElement | null;
        const checkIcon = btn.querySelector('.check-icon') as HTMLElement | null;

        btn.classList.add('copied');
        if (copyText) copyText.textContent = 'Copied!';
        if (copyIcon) copyIcon.style.display = 'none';
        if (checkIcon) checkIcon.style.display = 'inline-block';

        setTimeout(() => {
          btn.classList.remove('copied');
          if (copyText) copyText.textContent = 'Copy';
          if (copyIcon) copyIcon.style.display = 'inline-block';
          if (checkIcon) checkIcon.style.display = 'none';
        }, 2000);
      });
    });

    // Initial render
    updateTerminal();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAssistantSwitcher);
  } else {
    setupAssistantSwitcher();
  }
</script>
