    outline: none !important;
  }

  .pricing-card-footer {
    margin-top: auto;
  }

  .pricing-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    height: 2.65rem;
    padding: 0 var(--space-20);
    border-radius: var(--radius-pill) !important;
    font-family: var(--font-mono);
    font-size: 0.825rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
