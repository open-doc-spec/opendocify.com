---
import Layout from '@/layouts/FullWidthLayout.astro';
import HeroSplit from '@/components/sections/HeroSplit.astro';
import Stats from '@/components/sections/Stats.astro';
import Features from '@/components/sections/Features.astro';
import CTA from '@/components/sections/CTA.astro';
import { REPO_URL } from '@/lib/releases';

const stats = [
  { value: '94%', label: 'less AI context', description: 'Send only relevant pages.' },
  { value: '<5ms', label: 'context lookup', description: 'Fast enough for every prompt.' },
  { value: '17+', label: 'AI tools', description: 'Works with your existing workflow.' },
  { value: '100%', label: 'local processing', description: 'Your workspace stays yours.' },
];
const features = [
  { icon: 'link', title: 'Connect documents to code', description: 'Link a guide or spec directly to functions, tests, schemas, and implementation files.' },
  { icon: 'zap', title: 'Keep links healthy', description: 'Run the local watcher so the graph survives document moves and renames.' },
  { icon: 'shield', title: 'Control what is shared', description: 'Use profiles and visibility keys to keep private material out of exported context.' },
];
---

<Layout title="Open Document Spec (ODS) — precise context for AI" activeNav="home">
  <HeroSplit title="Give AI the right documents, not the whole repository." subtitle="ODS adds a lightweight map to your Markdown files so AI assistants can follow the exact pages, specs, and code connections that matter." tagline="Open Document Spec · local-first context" primaryCta={{ href: '/docs/quickstart', label: 'Start with the quickstart' }} secondaryCta={{ href: REPO_URL, label: 'View on GitHub ↗' }}>
    <div class="relative w-full overflow-hidden rounded-2xl border border-border bg-card shadow-2xl shadow-foreground/10" aria-label="ODS context command output">
      <div class="flex items-center justify-between border-b border-border px-4 py-3 font-mono text-xs text-muted-foreground"><span class="flex gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-border"></i><i class="h-2.5 w-2.5 rounded-full bg-border"></i><i class="h-2.5 w-2.5 rounded-full bg-primary"></i></span><span>ods context docs/guide/01-introduction.md</span><span>under 5ms</span></div>
      <pre class="overflow-auto p-6 font-mono text-xs leading-7 text-muted-foreground"><code><span class="text-primary">$</span> ods context docs/guide/01-introduction.md

Smart reading list
├── <span class="text-primary">docs/guide/01-introduction.md</span>  main page
├── <span class="text-primary">specs/ods/intro.md</span>           linked page
├── <span class="text-primary">docs/guide/05-profiles.md</span>    related page
└── <span class="text-primary">src/ods-core/graph.rs</span>        code connection

<span class="text-primary">✓</span> 4,120 tokens selected
<span class="text-primary">✓</span> 94% less context than the whole folder</code></pre>
    </div>
  </HeroSplit>

  <Stats stats={stats} />

  <section class="px-6 py-20"><div class="container mx-auto max-w-5xl"><div class="flex flex-col gap-4 text-center" data-animate><span class="mx-auto inline-flex w-fit rounded-full border border-border bg-muted px-4 py-1.5 font-mono text-sm text-muted-foreground">The problem with giant context windows</span><h2 class="text-3xl font-bold md:text-5xl">Better context starts with a better map.</h2><p class="mx-auto max-w-2xl text-lg text-muted-foreground">ODS makes the relationships already in your documentation explicit, deterministic, and easy for people or AI to follow.</p></div><div class="mt-12 grid gap-6 md:grid-cols-2"><div class="rounded-lg border bg-card p-6" data-animate="slide-left"><span class="rounded-full border px-2.5 py-0.5 text-xs font-semibold">Without ODS</span><h3 class="mt-4 text-2xl font-semibold">Everything gets dumped into the prompt.</h3><p class="mt-3 text-muted-foreground">Irrelevant pages raise token cost, slow responses, and make it easier for an assistant to connect the wrong facts.</p><pre class="mt-5 rounded-md border bg-muted p-4 font-mono text-sm text-muted-foreground">1,000 pages → 80,000 words → noisy answer</pre></div><div class="rounded-lg border border-primary bg-card p-6" data-animate="slide-right"><span class="rounded-full border border-primary bg-primary px-2.5 py-0.5 text-xs font-semibold text-primary-foreground">With ODS</span><h3 class="mt-4 text-2xl font-semibold">The right pages arrive in the right order.</h3><p class="mt-3 text-muted-foreground">Frontmatter and document links become a reading list that preserves meaning without a hosted vector database.</p><pre class="mt-5 rounded-md border bg-muted p-4 font-mono text-sm text-muted-foreground">2 pages → 4,120 words → focused answer</pre></div></div></div></section>

  <Features title="A small layer with a large payoff." subtitle="Build a knowledge base your team can actually maintain, using the files you already write." features={features} />

  <section class="section-muted px-6 py-20"><div class="container mx-auto max-w-5xl"><div class="flex flex-col items-center gap-4 text-center" data-animate><span class="inline-flex w-fit rounded-full border border-border bg-background px-4 py-1.5 font-mono text-sm text-muted-foreground">From zero to useful in minutes</span><h2 class="text-3xl font-bold md:text-5xl">Three commands. One clearer workspace.</h2></div><div class="mt-12 grid gap-6 md:grid-cols-3">{[['01','Prepare the folder','ods init .'],['02','Build a reading list','ods context doc.md'],['03','Keep it healthy','ods serve']].map(([number, title, command]) => <div class="rounded-lg border bg-card p-6" data-animate><span class="text-4xl font-bold text-primary">{number}</span><h3 class="mt-4 text-xl font-semibold">{title}</h3><p class="mt-2 text-muted-foreground">{number === '01' ? 'Initialize a root map that gives people and agents a reliable starting point.' : number === '02' ? 'Ask for context around one document instead of attaching everything.' : 'Run the watcher to validate links and repair the graph as files change.'}</p><pre class="mt-5 rounded-md border bg-muted p-3 font-mono text-xs text-muted-foreground">$ {command}</pre></div>)}</div></div></section>

  <CTA title="Make your next AI answer easier to trust." description="Read the quickstart, add ODS to a real folder, and see the map it builds." cta={{ href: '/docs/quickstart', label: 'Read the quickstart →' }} />
</Layout>
