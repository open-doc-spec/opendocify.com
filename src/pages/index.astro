    box-shadow: 0 4px 24px -4px rgba(0, 0, 0, 0.4) !important;
  }

  .pricing-home-card:hover {
    transform: translateY(-2px);
    border: none !important;
    outline: none !important;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.08) !important;
  }

  .dark .pricing-home-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border: none !important;
    outline: none !important;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.6) !important;
  }

  .pricing-home-card.featured {
    background: var(--card-bg, #ffffff);
    border: none !important;
    outline: none !important;
    box-shadow: 0 12px 36px -12px rgba(0, 0, 0, 0.08), 0 0 0 1px rgba(0, 0, 0, 0.04) !important;
  }

  .dark .pricing-home-card.featured {
    border: none !important;
    outline: none !important;
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.08) !important;
  }

  .pricing-card-header {
    text-align: left;
    margin-bottom: var(--space-12);
  }

  .pricing-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
    text-align: left;
  }

  .pricing-tier-name {
    text-align: left;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  .badge-status {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: none !important;
    outline: none !important;
  }

  .badge-status.badge-active {
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
    border: none !important;
    outline: none !important;
  }

  .dark .badge-status.badge-active {
    color: #10b981;
    background: rgba(16, 185, 129, 0.15);
    border: none !important;
    outline: none !important;
  }

  .badge-status.badge-roadmap {
