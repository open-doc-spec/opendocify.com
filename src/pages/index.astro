    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pathway-type-pill {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--fg-muted);
  }

  .path-badge {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 650;
    padding: 5px 14px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    white-space: nowrap;
    line-height: 1.3;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border-color);
  }

  .pathway-heading {
    font-size: 1.18rem;
    font-weight: 650;
    color: var(--fg);
    margin-bottom: var(--space-6);
  }

  .pathway-desc {
    font-size: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.5;
    margin-bottom: var(--space-16);
  }

  /* ── Minimal Pathway Terminal / Prompt Graphics ── */

  .pathway-terminal-box {
    background: #090d16 !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: var(--radius-md, 8px);
