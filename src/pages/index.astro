---
// FILE: index.astro
// Purpose: High-Converting ODS Landing Page with Interactive Hero Token Calculator & Pareto 80/20 Core Features.
// Preserves ods visual design system & dark theme (#09090b).

import AIIcon from "../components/AIIcon.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { REPO_URL } from "../lib/releases";
---

<Layout activeNav="home">
  <!-- Background Dot-Matrix Graphic Pattern -->
  <div class="dot-matrix-bg"></div>

  <!-- Funnel Step 1: Hero Header with Interactive ROI Token Calculator -->
  <section class="hero-section">
    <!-- Ethereal Animated Soft Blur Visual Gradient & Waves Backdrop -->
    <div class="hero-visual-gradient-backdrop" aria-hidden="true">
      <div class="hero-glow-blob blob-mint"></div>
      <div class="hero-glow-blob blob-blue"></div>
      <div class="hero-glow-blob blob-soft"></div>
      <div class="hero-glow-blob blob-bottom-sync"></div>
      <div class="hero-waves-wrapper">
        <svg class="hero-waves-svg" viewBox="0 0 1440 900" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
          <path d="M 720 -120 C 1020 120, 1300 380, 1480 820" stroke="url(#hero-wave-1)" stroke-width="1.8" opacity="0.4" />
          <path d="M 780 -90 C 1080 160, 1340 430, 1520 860" stroke="url(#hero-wave-1)" stroke-width="1.2" opacity="0.28" />
          <path d="M 840 -60 C 1140 200, 1380 480, 1560 900" stroke="url(#hero-wave-1)" stroke-width="0.8" opacity="0.18" />
          <path d="M -160 480 C 140 640, 540 740, 1080 890" stroke="url(#hero-wave-2)" stroke-width="1.5" opacity="0.32" />
          <path d="M -100 550 C 200 700, 600 780, 1140 930" stroke="url(#hero-wave-2)" stroke-width="1" opacity="0.22" />
          <defs>
            <linearGradient id="hero-wave-1" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.65"/>
              <stop offset="60%" stop-color="#60a5fa" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#10b981" stop-opacity="0.05"/>
            </linearGradient>
            <linearGradient id="hero-wave-2" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#10b981" stop-opacity="0.6"/>
              <stop offset="50%" stop-color="#34d399" stop-opacity="0.3"/>
              <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.05"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="hero-dot-matrix"></div>
      <div class="hero-bottom-gradient-sync"></div>
    </div>

    <h1 class="tagline">Make your documents easy for people and AI to understand.</h1>

    <p class="hero-subtext">
      ODS maps connections across your files so AI tools (Claude, Cursor, Copilot & Antigravity) read only what they need — giving you <strong>instant answers</strong> while <strong>saving up to 94% in AI costs</strong>.
    </p>

    <div class="hero-actions">
      <a id="download-btn" href="/docs" class="hero-button shimmer-btn">
        <svg class="hero-button-sparkle" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3z"/></svg>
        <span id="download-label">Enable ODS AI Skill</span>
        <span class="hero-button-arrow">→</span>
      </a>

      <a href="/features" class="hero-secondary-button">Explore All 38 Features →</a>
    </div>

    <!-- Single Unified Interactive CLI & Quick Install Terminal Box inside Hero -->
    <div class="cli-wrap">
      <div class="cli-header">
        <div class="cli-dots">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="cli-title-group">
          <span class="cli-title">ODS Interactive Terminal</span>
          <span class="cli-tag">SUPER-FAST &lt; 5MS</span>
        </div>
        <button id="hero-cli-replay" class="cli-replay-btn" title="Replay typing animation">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          <span>Replay</span>
        </button>
      </div>

      <!-- Unified Preset Bar: Install Methods + CLI Commands -->
      <div class="cli-preset-bar">
        <div class="preset-group">
          <span class="preset-label">INSTALL:</span>
          <button class="hero-cmd-preset active" data-preset="curl">curl</button>
          <button class="hero-cmd-preset" data-preset="cargo">cargo</button>
          <button class="hero-cmd-preset" data-preset="npm">npm</button>
        </div>
        <div class="preset-divider" aria-hidden="true"></div>
        <div class="preset-group">
          <span class="preset-label">COMMANDS:</span>
          <button class="hero-cmd-preset" data-preset="context">$ ods context</button>
          <button class="hero-cmd-preset" data-preset="lint">$ ods lint</button>
          <button class="hero-cmd-preset" data-preset="graph">$ ods graph</button>
        </div>
      </div>

      <div class="cli-body">
        <div class="cli-line">
          <div class="cli-cmd-container">
            <span class="cli-prompt">$</span>
            <span id="hero-typing-cmd" class="cli-command">curl -fsSL https://opendocify.com/install.sh | bash</span><span class="t-cursor"></span>
          </div>
          <button id="copy-cmd-btn" class="cli-copy-btn" type="button" title="Copy Command">
            <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:none;"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="copy-label">Copy</span>
          </button>
        </div>
        <div id="hero-cli-output" class="cli-output">
          <div class="cli-log"><span class="cli-checkmark">✓</span> Downloading latest ODS release binary package...</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Verified checksum & installed ods v0.1.0 to /usr/local/bin/ods</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Initialized workspace environment (~/.ods)</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Connected to Cursor, Claude, Copilot & Antigravity</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics & Social Proof Strip -->
  <section class="section-container metrics-strip-section">
    <div class="metrics-grid">
      <div class="metric-item">
        <div class="metric-value">94.97%</div>
        <div class="metric-label">Saved in AI Cost</div>
      </div>

      <div class="metric-item">
        <div class="metric-value">&lt; 5ms</div>
        <div class="metric-label">Scanning Speed</div>
      </div>

      <div class="metric-item">
        <div class="metric-value">17+</div>
        <div class="metric-label">AI Tools Supported</div>
      </div>

      <div class="metric-item">
        <div class="metric-value">100%</div>
        <div class="metric-label">Private & Secure</div>
      </div>
    </div>
  </section>

  <!-- ODS Context Precision Visual Flow Section -->
  <section class="section-container cookbook-analogy-section" id="cookbook-example">
    <h2 class="section-heading">Give AI Less. Let It Understand More.</h2>
    <p class="section-subheading">ODS finds the information that matters before AI starts processing — reducing noise, cost, and unnecessary context.</p>

    <div class="ods-flow-wrapper">
      <!-- Main Continuous Editorial Visual Card -->
      <div class="ods-flow-card">
        <!-- 3 Step Header Strip -->
        <div class="ods-flow-header-grid">
          <div class="ods-flow-step step-everything">
            <span class="ods-step-badge">01</span>
            <span class="ods-step-title">Everything</span>
            <span class="ods-step-desc">Too much information</span>
          </div>

          <div class="ods-flow-step step-ods">
            <span class="ods-step-badge">02</span>
            <span class="ods-step-title">ODS finds what matters</span>
            <span class="ods-step-desc">Filters before AI starts</span>
          </div>

          <div class="ods-flow-step step-ai">
            <span class="ods-step-badge">03</span>
            <span class="ods-step-title">Relevant context</span>
            <span class="ods-step-desc">Only what AI needs</span>
          </div>
        </div>

        <!-- Visual Continuous Flow Canvas -->
        <div class="ods-flow-visual">
          <svg viewBox="0 0 1000 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="ods-flow-svg">
            <!-- CONVERGING NOISE LINES (Top & Bottom Discarded Paths) -->
            <g class="noise-lines-group">
              <path d="M 240 65 C 310 65, 340 160, 390 160" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.3" class="animated-dash-slow"/>
              <path d="M 240 95 C 310 95, 340 165, 390 165" stroke="var(--fg-muted)" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.2" class="animated-dash-slow"/>
              <path d="M 240 125 C 310 125, 340 170, 390 170" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.25" class="animated-dash-slow"/>
              <path d="M 240 235 C 310 235, 340 190, 390 190" stroke="var(--fg-muted)" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.2" class="animated-dash-slow"/>
              <path d="M 240 265 C 310 265, 340 195, 390 195" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.25" class="animated-dash-slow"/>
              <path d="M 240 295 C 310 295, 340 200, 390 200" stroke="var(--fg-muted)" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.2" class="animated-dash-slow"/>
            </g>

            <!-- CONVERGING RELEVANT PATHS (3 Green Focused Lines into ODS) -->
            <g class="relevant-lines-input">
              <path d="M 240 155 C 305 155, 345 175, 390 175" stroke="#10b981" stroke-width="2" opacity="0.75" class="animated-dash"/>
              <path d="M 240 180 L 390 180" stroke="#10b981" stroke-width="2.5" opacity="0.95" class="animated-dash"/>
              <path d="M 240 205 C 305 205, 345 185, 390 185" stroke="#10b981" stroke-width="2" opacity="0.75" class="animated-dash"/>
            </g>

            <!-- ODS OUTPUT PATHS (3 Green Clean Lines out to Relevant Context) -->
            <g class="relevant-lines-output">
              <path d="M 454 175 C 495 175, 520 120, 560 120" stroke="#10b981" stroke-width="2" opacity="0.9" class="animated-dash"/>
              <path d="M 454 180 L 560 180" stroke="#10b981" stroke-width="2.5" opacity="1" class="animated-dash"/>
              <path d="M 454 185 C 495 185, 520 240, 560 240" stroke="#10b981" stroke-width="2" opacity="0.9" class="animated-dash"/>
            </g>

            <!-- RELEVANT CONTEXT TO AI PATHS -->
            <g class="ai-input-lines">
              <path d="M 614 120 C 665 120, 690 170, 725 172" stroke="#10b981" stroke-width="2" opacity="0.85" class="animated-dash"/>
              <path d="M 614 180 L 725 180" stroke="#10b981" stroke-width="2.5" opacity="1" class="animated-dash"/>
              <path d="M 614 240 C 665 240, 690 190, 725 188" stroke="#10b981" stroke-width="2" opacity="0.85" class="animated-dash"/>
            </g>

            <!-- AI TO BETTER ANSWER PATH -->
            <path d="M 771 180 L 820 180" stroke="#10b981" stroke-width="2.5" opacity="1" class="animated-dash"/>

            <!-- ── STEP 01: EVERYTHING DOCUMENT CLUSTER (12 DOCUMENTS) ── -->
            <g class="doc-cluster">
              <!-- Row 1: Discarded documents -->
              <g class="doc-shape doc-discarded" transform="translate(35, 45)">
                <rect width="44" height="56" rx="5" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.2" opacity="0.45"/>
                <line x1="8" y1="12" x2="30" y2="12" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="20" x2="36" y2="20" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="28" x2="24" y2="28" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="36" x2="32" y2="36" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <circle cx="36" cy="12" r="2" fill="#ef4444" opacity="0.6"/>
              </g>

              <g class="doc-shape doc-discarded" transform="translate(90, 32)">
                <rect width="44" height="56" rx="5" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.2" opacity="0.45"/>
                <line x1="8" y1="12" x2="36" y2="12" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="20" x2="28" y2="20" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="28" x2="32" y2="28" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
              </g>

              <g class="doc-shape doc-discarded" transform="translate(145, 40)">
                <rect width="44" height="56" rx="5" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.2" opacity="0.45"/>
                <line x1="8" y1="12" x2="32" y2="12" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="20" x2="24" y2="20" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="28" x2="36" y2="28" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <circle cx="36" cy="28" r="2" fill="#ef4444" opacity="0.6"/>
              </g>

              <g class="doc-shape doc-discarded" transform="translate(200, 52)">
                <rect width="44" height="56" rx="5" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.2" opacity="0.45"/>
                <line x1="8" y1="12" x2="28" y2="12" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="20" x2="36" y2="20" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="28" x2="20" y2="28" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
              </g>

              <!-- Row 2: Selected 3 Prominent Documents -->
              <g class="doc-shape doc-prominent" transform="translate(58, 126)">
                <rect width="48" height="60" rx="6" fill="var(--card-bg)" stroke="#10b981" stroke-width="1.8"/>
                <line x1="9" y1="14" x2="32" y2="14" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
                <line x1="9" y1="23" x2="39" y2="23" stroke="var(--fg)" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
                <line x1="9" y1="31" x2="27" y2="31" stroke="var(--fg)" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
                <line x1="9" y1="39" x2="35" y2="39" stroke="var(--fg)" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
                <circle cx="39" cy="14" r="2.5" fill="#10b981"/>
              </g>

              <g class="doc-shape doc-prominent" transform="translate(123, 150)">
                <rect width="48" height="60" rx="6" fill="var(--card-bg)" stroke="#10b981" stroke-width="2.2"/>
                <line x1="9" y1="14" x2="36" y2="14" stroke="#10b981" stroke-width="2.2" stroke-linecap="round"/>
                <line x1="9" y1="23" x2="39" y2="23" stroke="var(--fg)" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
                <line x1="9" y1="31" x2="31" y2="31" stroke="var(--fg)" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
                <line x1="9" y1="39" x2="23" y2="39" stroke="var(--fg)" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
                <circle cx="39" cy="14" r="2.5" fill="#10b981"/>
              </g>

              <g class="doc-shape doc-prominent" transform="translate(188, 132)">
                <rect width="48" height="60" rx="6" fill="var(--card-bg)" stroke="#10b981" stroke-width="1.8"/>
                <line x1="9" y1="14" x2="30" y2="14" stroke="#10b981" stroke-width="2" stroke-linecap="round"/>
                <line x1="9" y1="23" x2="39" y2="23" stroke="var(--fg)" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
                <line x1="9" y1="31" x2="33" y2="31" stroke="var(--fg)" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
                <line x1="9" y1="39" x2="37" y2="39" stroke="var(--fg)" stroke-width="1.8" stroke-linecap="round" opacity="0.85"/>
                <circle cx="39" cy="14" r="2.5" fill="#10b981"/>
              </g>

              <!-- Row 3: Discarded documents -->
              <g class="doc-shape doc-discarded" transform="translate(28, 222)">
                <rect width="44" height="56" rx="5" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.2" opacity="0.45"/>
                <line x1="8" y1="12" x2="36" y2="12" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="20" x2="24" y2="20" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="28" x2="32" y2="28" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
              </g>

              <g class="doc-shape doc-discarded" transform="translate(82, 238)">
                <rect width="44" height="56" rx="5" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.2" opacity="0.45"/>
                <line x1="8" y1="12" x2="28" y2="12" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="20" x2="36" y2="20" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="28" x2="20" y2="28" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <circle cx="36" cy="20" r="2" fill="#ef4444" opacity="0.6"/>
              </g>

              <g class="doc-shape doc-discarded" transform="translate(138, 248)">
                <rect width="44" height="56" rx="5" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.2" opacity="0.45"/>
                <line x1="8" y1="12" x2="32" y2="12" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="20" x2="36" y2="20" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="28" x2="24" y2="28" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
              </g>

              <g class="doc-shape doc-discarded" transform="translate(194, 228)">
                <rect width="44" height="56" rx="5" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.2" opacity="0.45"/>
                <line x1="8" y1="12" x2="36" y2="12" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="20" x2="28" y2="20" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="28" x2="32" y2="28" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <circle cx="36" cy="12" r="2" fill="#ef4444" opacity="0.6"/>
              </g>

              <g class="doc-shape doc-discarded" transform="translate(226, 178)">
                <rect width="42" height="52" rx="5" fill="var(--card-bg)" stroke="var(--border-color)" stroke-width="1.2" opacity="0.35"/>
                <line x1="8" y1="12" x2="30" y2="12" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="20" x2="24" y2="20" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
                <line x1="8" y1="28" x2="28" y2="28" stroke="var(--fg-muted)" opacity="0.3" stroke-width="1.5"/>
              </g>
            </g>

            <!-- ── STEP 02: ODS FILTER NODE ── -->
            <g class="ods-filter-node" transform="translate(390, 138)">
              <!-- Pulsing focus frame -->
              <rect width="64" height="84" rx="14" fill="var(--card-bg)" stroke="#10b981" stroke-width="2" class="ods-node-glow"/>
              <rect x="4" y="4" width="56" height="76" rx="10" fill="var(--nested-card-bg)" stroke="var(--border-color)" stroke-width="1"/>
              
              <!-- Official ODS Logo Brand Mark -->
              <g transform="translate(16, 12) scale(0.20)">
                <path d="M99 14C105.5 14 140.5 52 140.5 56H120C108.402 56 99 46.598 99 35V14Z" fill="#10b981" />
                <path d="M6 106.443V35C6 23.402 15.402 14 27 14H99M99 14C105.5 14 140.5 52 140.5 56M99 14V35C99 46.598 108.402 56 120 56H140.5M140.5 56V106.443M52 92.5L28 115M73.5 103.5V144M94 92.5L118 115" stroke="#10b981" stroke-width="10" stroke-linecap="round" />
                <circle cx="73" cy="80" r="11" fill="#10b981" />
                <circle cx="12" cy="134" r="11" fill="#10b981" />
                <circle cx="134" cy="134" r="11" fill="#10b981" />
              </g>
              
              <text x="32" y="66" fill="var(--fg)" font-family="Inter, sans-serif" font-size="11" font-weight="800" text-anchor="middle" letter-spacing="0.06em">ODS</text>
            </g>

            <!-- ── STEP 03: RELEVANT CONTEXT (3 TARGETED DOCUMENTS) ── -->
            <g class="relevant-context-cluster">
              <g class="doc-shape doc-output-item" transform="translate(560, 88)">
                <rect width="54" height="66" rx="6" fill="var(--card-bg)" stroke="#10b981" stroke-width="2"/>
                <line x1="10" y1="14" x2="34" y2="14" stroke="#10b981" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="10" y1="25" x2="44" y2="25" stroke="var(--fg)" stroke-width="2" stroke-linecap="round"/>
                <line x1="10" y1="34" x2="38" y2="34" stroke="var(--fg)" stroke-width="2" stroke-linecap="round"/>
                <line x1="10" y1="43" x2="42" y2="43" stroke="var(--fg)" stroke-width="2" stroke-linecap="round"/>
                <circle cx="44" cy="14" r="3" fill="#10b981"/>
              </g>

