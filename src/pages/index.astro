<script>
  function setupHeroTypingTerminal() {
    const cmdElem = document.getElementById('hero-typing-cmd');
    const outputElem = document.getElementById('hero-cli-output');
    const replayBtn = document.getElementById('hero-cli-replay');
    const presetBtns = document.querySelectorAll<HTMLButtonElement>('.hero-cmd-preset');
    const copyBtn = document.getElementById('copy-cmd-btn');

    if (!cmdElem || !outputElem) return;

    const presets: Record<string, { cmd: string; outputHtml: string }> = {
      curl: {
        cmd: 'curl -fsSL https://opendocify.com/install.sh | bash',
        outputHtml: `
          <div class="cli-log"><span class="cli-checkmark">✓</span> Downloading latest ODS release binary package...</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Verified checksum & installed ods v0.1.0 to /usr/local/bin/ods</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Initialized workspace environment (~/.ods)</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Connected to Cursor, Claude, Copilot & Antigravity</div>
        `
      },
      cargo: {
        cmd: 'cargo install ods',
        outputHtml: `
          <div class="cli-log"><span class="cli-checkmark">✓</span> Compiling ods v0.1.0 from crates.io...</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Optimized release build created [target/release/ods]</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Binary installed to ~/.cargo/bin/ods</div>
        `
      },
      npm: {
        cmd: 'npm install -g @ods/cli',
        outputHtml: `
          <div class="cli-log"><span class="cli-checkmark">✓</span> Fetching @ods/cli package from npm registry...</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Linked binary executable node_modules/@ods/cli/bin/ods</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Complete! Run \`ods init\` in any document repository</div>
        `
      },
      context: {
        cmd: 'ods context docs/guide/01-introduction.md',
        outputHtml: `
          <div class="cli-tree">
            Smart Reading List for [01-introduction.md]:<br/>
            ├── docs/guide/01-introduction.md <span class="tree-tag">(Main page)</span><br/>
            ├── specs/ods/intro.md <span class="tree-tag">(linked page)</span><br/>
            ├── docs/guide/05-profiles.md <span class="tree-tag">(related page)</span><br/>
            └── src/crates/ods-core/src/graph.rs <span class="tree-tag">(connected code)</span>
          </div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Total Context Size: 4,120 tokens (saves 94.97% AI token costs)</div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Instant Lookup: Reading map built in 2.8ms</div>
        `
      },
      lint: {
        cmd: 'ods lint .',
        outputHtml: `
          <div class="cli-tree">
            Scanning 48 documents in current workspace...<br/>
            ├── Frontmatter metadata schemas: OK<br/>
            ├── 142 document cross-references: OK<br/>
            └── Graph consistency across 4 profiles: OK
          </div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Workspace clean: 0 errors, 0 broken links (1.9ms)</div>
        `
      },
      graph: {
        cmd: 'ods graph .',
        outputHtml: `
          <div class="cli-tree">
            Generating document graph edges...<br/>
            ├── Nodes: 48 documents, 182 graph edges<br/>
            └── Graph map written to .ods/graph.md
          </div>
          <div class="cli-log"><span class="cli-checkmark">✓</span> Graph synchronized with 17+ AI coding assistants (2.1ms)</div>
        `
      }
    };

    let activePreset = 'curl';
    let currentRawCmd = presets.curl.cmd;

    function renderCommand(presetKey: string) {
      activePreset = presetKey;
      const item = presets[presetKey] || presets.curl;
      currentRawCmd = item.cmd;

      presetBtns.forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-preset') === presetKey);
      });

      // Always populate command text & output HTML instantly (100% reliable & visible)
      if (cmdElem) cmdElem.textContent = item.cmd;
      if (outputElem) {
        outputElem.innerHTML = item.outputHtml;
        outputElem.style.opacity = '1';
        outputElem.style.transform = 'none';
      }
    }

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const presetKey = btn.getAttribute('data-preset');
        if (presetKey) renderCommand(presetKey);
      });
    });

    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        renderCommand(activePreset);
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(currentRawCmd);
        copyBtn.classList.add('copied');
        const copyLabel = copyBtn.querySelector('.copy-label') as HTMLElement | null;
        const copyIcon = copyBtn.querySelector('.copy-icon') as HTMLElement | null;
        const checkIcon = copyBtn.querySelector('.check-icon') as HTMLElement | null;
        if (copyLabel) copyLabel.textContent = 'Copied!';
        if (copyIcon) copyIcon.style.display = 'none';
        if (checkIcon) checkIcon.style.display = 'inline-block';

        setTimeout(() => {
          copyBtn.classList.remove('copied');
          if (copyLabel) copyLabel.textContent = 'Copy';
          if (copyIcon) copyIcon.style.display = 'inline-block';
          if (checkIcon) checkIcon.style.display = 'none';
        }, 2000);
      });
    }

    // Render statically & instantly on initial page load
    renderCommand('curl');
  }

  function setupTokenCalculator() {
    const devInput = document.getElementById("dev-count") as HTMLInputElement;
    const promptsInput = document.getElementById("prompts-count") as HTMLInputElement;
    const modelSelect = document.getElementById("model-select") as HTMLSelectElement;
    const currencySelect = document.getElementById("calc-currency-select") as HTMLSelectElement | null;

    const devVal = document.getElementById("dev-count-val");
    const promptsVal = document.getElementById("prompts-count-val");
    const tokensOut = document.getElementById("out-tokens-saved");
    const costOut = document.getElementById("out-annual-saved");

    if (!devInput || !promptsInput || !modelSelect) return;

    const modelsData = [
      { id: "gpt-55", name: "GPT-5.5", provider: "OpenAI", usdPrice: 2.50 },
      { id: "gpt-55-mini", name: "GPT-5.5 Mini", provider: "OpenAI", usdPrice: 0.20 },
      { id: "gpt-55-nano", name: "GPT-5.5 Nano", provider: "OpenAI", usdPrice: 0.05 },
      { id: "o3", name: "o3", provider: "OpenAI", usdPrice: 10.00 },
      { id: "o4-mini", name: "o4-mini", provider: "OpenAI", usdPrice: 1.10 },
      { id: "claude-opus-5", name: "Claude Opus 5", provider: "Anthropic", usdPrice: 15.00 },
      { id: "claude-sonnet-46", name: "Claude Sonnet 4.6", provider: "Anthropic", usdPrice: 3.00 },
      { id: "claude-haiku-45", name: "Claude Haiku 4.5", provider: "Anthropic", usdPrice: 0.80 },
      { id: "gemini-36-flash", name: "Gemini 3.6 Flash", provider: "Google", usdPrice: 1.50 },
      { id: "gemini-35-flash-lite", name: "Gemini 3.5 Flash Lite", provider: "Google", usdPrice: 0.075 },
      { id: "gemini-31-pro", name: "Gemini 3.1 Pro", provider: "Google", usdPrice: 1.25 },
      { id: "grok-420", name: "Grok 4.20", provider: "xAI", usdPrice: 2.00 },
      { id: "deepseek-v4-pro", name: "DeepSeek V4 Pro", provider: "DeepSeek", usdPrice: 0.40 },
      { id: "deepseek-r1", name: "DeepSeek R1", provider: "DeepSeek", usdPrice: 0.55 },
      { id: "qwen-37-max", name: "Qwen 3.7 Max", provider: "Alibaba", usdPrice: 1.20 },
      { id: "kimi-k3", name: "Kimi K3", provider: "Moonshot AI", usdPrice: 0.60 },
      { id: "glm-52", name: "GLM-5.2", provider: "Z.ai", usdPrice: 0.50 },
      { id: "llama-4-maverick", name: "Llama 4 Maverick", provider: "Meta", usdPrice: 0.30 },
      { id: "llama-4-scout", name: "Llama 4 Scout", provider: "Meta", usdPrice: 0.10 },
      { id: "mistral-large-3", name: "Mistral Large 3", provider: "Mistral", usdPrice: 2.00 },
    ];

    const currencyMeta: Record<string, { rate: number; symbol: string; locale: string }> = {
      USD: { rate: 1.0, symbol: "$", locale: "en-US" },
      EUR: { rate: 0.92, symbol: "€", locale: "de-DE" },
      INR: { rate: 85.0, symbol: "₹", locale: "en-IN" },
    };

    function formatPrice(usdAmount: number, currKey: string): string {
      const meta = currencyMeta[currKey] || currencyMeta.USD;
      const val = usdAmount * meta.rate;
      if (currKey === "INR") {
        if (val >= 100) return `${meta.symbol}${val.toFixed(2)}`;
        return `${meta.symbol}${val.toFixed(2)}`;
      } else if (currKey === "EUR") {
        if (val < 0.1) return `${meta.symbol}${val.toFixed(3)}`;
        return `${meta.symbol}${val.toFixed(2)}`;
      } else {
        if (val < 0.1) return `${meta.symbol}${val.toFixed(3)}`;
        return `${meta.symbol}${val.toFixed(2)}`;
      }
    }

    function formatTotalSavings(usdAnnual: number, currKey: string): string {
      const meta = currencyMeta[currKey] || currencyMeta.USD;
      const converted = usdAnnual * meta.rate;
      const rounded = Math.round(converted);
      if (currKey === "INR") {
        return `${meta.symbol}${rounded.toLocaleString("en-IN")}`;
      } else if (currKey === "EUR") {
        return `${meta.symbol}${rounded.toLocaleString("de-DE")}`;
      } else {
        return `${meta.symbol}${rounded.toLocaleString("en-US")}`;
      }
    }

    const initialCurrency = localStorage.getItem("ods-currency") || "USD";
    if (currencySelect) {
      currencySelect.value = initialCurrency;
    }

    function updateModelOptions(currKey: string) {
      const selectedValue = modelSelect.value || "gpt-55";
      modelSelect.innerHTML = "";
      modelsData.forEach((m) => {
        const opt = document.createElement("option");
        opt.value = m.id;
        const formattedPrice = formatPrice(m.usdPrice, currKey);
        opt.textContent = `${m.name} : ${formattedPrice} / 1M tokens (${m.provider})`;
        if (m.id === selectedValue) {
          opt.selected = true;
        }
        modelSelect.appendChild(opt);
      });
    }

    function updateCalc() {
      const devs = parseInt(devInput.value, 10);
      const prompts = parseInt(promptsInput.value, 10);
      const selectedModelId = modelSelect.value || "gpt-55";
      const activeCurrency = currencySelect ? currencySelect.value : (localStorage.getItem("ods-currency") || "USD");

      if (devVal) devVal.textContent = `${devs} dev${devs > 1 ? "s" : ""}`;
      if (promptsVal) promptsVal.textContent = `${prompts} prompt${prompts > 1 ? "s" : ""}`;

      const targetModel = modelsData.find((m) => m.id === selectedModelId) || modelsData[0];
      const pricePerMillionUSD = targetModel.usdPrice;

      const tokensSavedPerPrompt = 77880;
      const dailyTokens = devs * prompts * tokensSavedPerPrompt;
      const annualTokens = dailyTokens * 250;
      const annualCostUSD = (annualTokens / 1000000) * pricePerMillionUSD;

      if (tokensOut) tokensOut.textContent = dailyTokens.toLocaleString();
      if (costOut) costOut.textContent = formatTotalSavings(annualCostUSD, activeCurrency);
    }

    function syncCurrency(newCurrency: string) {
      if (currencySelect && currencySelect.value !== newCurrency) {
        currencySelect.value = newCurrency;
      }
      localStorage.setItem("ods-currency", newCurrency);
      updateModelOptions(newCurrency);
      updateCalc();
    }

    if (currencySelect) {
      currencySelect.addEventListener("change", (e) => {
        const val = (e.target as HTMLSelectElement).value;
        syncCurrency(val);
        window.dispatchEvent(new CustomEvent("ods-currency-change", { detail: { currency: val } }));
      });
    }

    window.addEventListener("ods-currency-change", (e: Event) => {
      const customEvt = e as CustomEvent<{ currency: string }>;
      const c = customEvt.detail?.currency;
      if (c) syncCurrency(c);
    });

    updateModelOptions(initialCurrency);
    updateCalc();

    devInput.addEventListener("input", updateCalc);
    promptsInput.addEventListener("input", updateCalc);
    modelSelect.addEventListener("change", updateCalc);
  }

  function setupHomePricingToggle() {
    const monthlyBtn = document.getElementById("home-toggle-monthly");
    const yearlyBtn = document.getElementById("home-toggle-yearly");
    const priceNum = document.getElementById("home-pro-price-num");
    const pricePeriod = document.getElementById("home-pro-price-period");
    const priceSubnote = document.getElementById("home-pro-price-subnote");
    const priceSubtext = document.getElementById("home-pro-price-subtext");
    const ctaBtn = document.getElementById("home-pro-cta-btn");

    if (!monthlyBtn || !yearlyBtn || !priceNum || !pricePeriod) return;

    monthlyBtn.addEventListener("click", () => {
      monthlyBtn.classList.add("active");
      yearlyBtn.classList.remove("active");
      priceNum.textContent = "$10";
      pricePeriod.textContent = "/ month";
      if (priceSubnote) priceSubnote.textContent = "";
      if (priceSubtext) priceSubtext.textContent = "Built for creators & teams working with AI assistants.";
      if (ctaBtn) ctaBtn.textContent = "Get ODS Pro for $10/mo";
    });

    yearlyBtn.addEventListener("click", () => {
      yearlyBtn.classList.add("active");
      monthlyBtn.classList.remove("active");
      priceNum.textContent = "$8";
      pricePeriod.textContent = "/ month";
      if (priceSubnote) priceSubnote.textContent = "✓ Billed annually at $96/yr (Save 20% / $24)";
      if (priceSubtext) priceSubtext.textContent = "Save 20% ($24/year). Includes live cloud backup and sync.";
      if (ctaBtn) ctaBtn.textContent = "Get ODS Pro for $8/mo ($96/yr)";
    });
  }

  function initHomeScripts() {
    setupHeroTypingTerminal();
    setupTokenCalculator();
    setupHomePricingToggle();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHomeScripts);
  } else {
    initHomeScripts();
  }
</script>

