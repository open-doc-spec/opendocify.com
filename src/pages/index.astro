  }

  .pricing-price-val {
    display: inline-flex;
    align-items: flex-start;
    line-height: 1;
    text-align: left;
  }

  .pricing-currency {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--fg);
    margin-top: 0.15rem;
    margin-right: 2px;
    line-height: 1;
    opacity: 0.85;
  }

  .pricing-amount {
    font-size: 3.25rem;
    font-weight: 800;
    color: var(--fg);
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-align: left;
  }

  .pricing-amount-text {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-align: left;
  }

  .pricing-period {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }

  .pricing-card-desc {
    text-align: left;
    font-size: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.45;
    margin: 0;
    min-height: 2.5rem;
  }

  .pricing-features-group {
    text-align: left;
    background: rgba(0, 0, 0, 0.025);
    border: none !important;
    outline: none !important;
    border-radius: var(--radius-md);
