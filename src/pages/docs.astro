---
// FILE: src/pages/docs.astro
// Purpose: Main /docs route rendering the default user guide in the MDX DocShell.

import { getCollection, render } from "astro:content";
import DocShell from "../components/DocShell.astro";

const allEntries = await getCollection("docs");
const preferred = ["learn.md", "learn", "00-why-ods.md", "01-introduction.md"];
const defaultEntry =
  preferred.map((id) => allEntries.find((entry) => (entry.id || "").replace(/\\/g, "/") === id || (entry.id || "").endsWith("/" + id))).find(Boolean) ||
  allEntries[0];

if (!defaultEntry) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(defaultEntry);
---

<DocShell
  collection="docs"
  currentEntry={defaultEntry}
  allEntries={allEntries}
  Content={Content}
  headings={headings}
/>
