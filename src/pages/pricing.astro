---
// FILE: pricing.astro
// Purpose: Minimal, high-craft Pricing page for ODS (100% Free & Open Source under Apache 2.0, Cloud roadmap).
// Layer: Marketing page

import Layout from "../layouts/Layout.astro";
import { REPO_URL } from "../lib/releases";
---

<Layout title="Pricing: Open Document Spec (ODS)" activeNav="pricing">
  <div class="pricing-page">
    <!-- Minimal Header -->
    <header class="pricing-header">
      <div class="pricing-eyebrow">
        <span class="status-dot"></span>
        <span>100% Free & Open Source</span>
      </div>
      <h1 class="pricing-title">Simple, transparent, and free.</h1>
      <p class="pricing-subtitle">
        Open Document Spec is Apache 2.0 licensed. Build, parse, and optimize AI document graphs with zero paywalls or subscriptions.
      </p>
    </header>

    <!-- Minimal 2-Column Tier Grid -->
    <div class="pricing-grid">
      <!-- Community Card -->
      <div class="pricing-card featured">
        <div class="card-top">
          <div class="card-badge-row">
            <span class="tier-label">Community</span>
            <span class="badge-active">Free Forever</span>
          </div>
          <div class="card-price">
            <span class="price-val">$0</span>
            <span class="price-period">/ forever</span>
          </div>
          <p class="card-desc">
            The full specification, schema validation, and CLI toolchain for local AI document graphs.
          </p>
        </div>

        <ul class="card-features">
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Full Open Document Specification (ODS)</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>CLI toolchain & 17+ AI agent adapters</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Up to 94% prompt token reduction</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Local markdown indexing & validation</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>100% open source under Apache 2.0</span>
          </li>
        </ul>

        <div class="card-actions">
          <a href="/docs" class="btn btn-primary">
            Get Started Free
            <span aria-hidden="true">→</span>
          </a>
          <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            GitHub
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Cloud Card -->
      <div class="pricing-card">
        <div class="card-top">
          <div class="card-badge-row">
            <span class="tier-label">Cloud & Teams</span>
            <span class="badge-roadmap">In Development</span>
          </div>
          <div class="card-price">
            <span class="price-val">Cloud</span>
            <span class="price-period">/ upcoming</span>
          </div>
          <p class="card-desc">
            Hosted team synchronization, compliance automation, and distributed graph collaboration.
          </p>
        </div>

        <ul class="card-features">
          <li>
            <svg class="check-icon muted" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Multi-repo cloud synchronization</span>
          </li>
          <li>
            <svg class="check-icon muted" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Automated graph drift & health detection</span>
          </li>
          <li>
            <svg class="check-icon muted" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Enterprise SSO & centralized audit logs</span>
          </li>
          <li>
            <svg class="check-icon muted" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Centralized organization workspaces</span>
          </li>
        </ul>

        <div class="card-actions">
          <a href={`${REPO_URL}/discussions`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-full">
            Follow Roadmap on GitHub
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Minimal Metrics Strip -->
    <div class="metrics-strip">
      <div class="metric-item">
        <span class="metric-num">94%</span>
        <span class="metric-lbl">Token Cost Reduction</span>
      </div>
      <div class="metric-sep" aria-hidden="true"></div>
      <div class="metric-item">
        <span class="metric-num">&lt; 5ms</span>
        <span class="metric-lbl">Index Scan Latency</span>
      </div>
      <div class="metric-sep" aria-hidden="true"></div>
      <div class="metric-item">
        <span class="metric-num">17+</span>
        <span class="metric-lbl">AI Assistants Supported</span>
      </div>
    </div>
  </div>
</Layout>

<style>
  .pricing-page {
    width: min(92vw, 960px);
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) 1rem clamp(4rem, 8vw, 6rem);
  }

  /* ── Header ── */
  .pricing-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(2.5rem, 5vw, 3.5rem);
  }

  .pricing-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: var(--color-surface, var(--color-card, rgba(0, 0, 0, 0.03)));
    border: none;
    color: var(--color-text-muted, var(--color-muted-foreground));
    font-size: 0.78rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.5);
  }

  .pricing-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-text, var(--color-foreground));
    margin-bottom: 1rem;
  }

  .pricing-subtitle {
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    color: var(--color-text-muted, var(--color-muted-foreground));
    line-height: 1.6;
    margin: 0;
  }

  /* ── 2-Column Grid ── */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: 3rem;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem;
    border-radius: 1.25rem;
    background: var(--color-card, #ffffff);
    border: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pricing-card:hover {
    border: none;
    transform: translateY(-2px);
  }

  .pricing-card.featured {
    border: none;
    box-shadow: 0 4px 20px -4px rgba(16, 185, 129, 0.1);
    position: relative;
  }

  .card-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .tier-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text, var(--color-foreground));
    letter-spacing: -0.01em;
  }

  .badge-active {
    font-size: 0.72rem;
    font-weight: 600;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    border: none;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }

  .badge-roadmap {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted, var(--color-muted-foreground));
    background: var(--color-surface-muted, rgba(0, 0, 0, 0.04));
    border: none;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }

  .card-price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .price-val {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-text, var(--color-foreground));
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .price-period {
    font-size: 0.85rem;
    color: var(--color-text-muted, var(--color-muted-foreground));
    font-weight: 500;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted, var(--color-muted-foreground));
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .card-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .card-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.85rem;
    color: var(--color-text, var(--color-foreground));
    line-height: 1.45;
  }

  .check-icon {
    width: 1rem;
    height: 1rem;
    color: #10b981;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .check-icon.muted {
    color: var(--color-text-subtle, var(--color-muted-foreground));
    opacity: 0.6;
  }

  .card-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: auto;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.65rem 1.25rem;
    border-radius: 0.65rem;
    text-decoration: none;
    transition: all 0.18s ease;
    line-height: 1;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--color-foreground, #0f172a);
    color: var(--color-background, #ffffff);
    flex: 1;
  }

  .btn-primary:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: var(--color-surface, rgba(0, 0, 0, 0.03));
    color: var(--color-text, var(--color-foreground));
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-surface-muted, rgba(0, 0, 0, 0.06));
    border-color: var(--color-border-strong, rgba(0, 0, 0, 0.2));
  }

  .btn-full {
    width: 100%;
  }

  /* ── Minimal Metrics Strip ── */
  .metrics-strip {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 1.5rem 2rem;
    border-radius: 1rem;
    background: var(--color-surface, var(--color-card, rgba(0, 0, 0, 0.02)));
    border: 1px solid var(--color-border);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
  }

  .metric-num {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-text, var(--color-foreground));
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .metric-lbl {
    font-size: 0.78rem;
    color: var(--color-text-muted, var(--color-muted-foreground));
    font-weight: 500;
  }

  .metric-sep {
    width: 1px;
    height: 2rem;
    background: var(--color-border);
  }

  /* ── Mobile ── */
  @media (max-width: 720px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .metrics-strip {
      flex-direction: column;
      gap: 1.25rem;
      padding: 1.25rem;
    }

    .metric-sep {
      width: 60%;
      height: 1px;
    }
  }
</style>
