---
import Layout from "../layouts/Layout.astro";
import { REPO_URL, RELEASES_URL } from "../lib/releases";
---

<Layout title="Install ODS — Open Document Spec" activeNav="docs">
  <section class="page-hero"><div class="container"><div class="section-header"><span class="eyebrow">Install in seconds</span><h1>Put a document map next to the files you already have.</h1><p class="lead">Choose the install path that fits your workflow. ODS runs locally and works with standard Markdown repositories.</p></div></div></section>
  <section class="section"><div class="container grid-2"><article class="card"><span class="tag">Recommended</span><h2>Install from your terminal</h2><p>Use the installer to fetch the latest release for your platform.</p><div class="code-block">curl -fsSL https://opendocify.com/install.sh | bash</div><a class="button button-primary" href={REPO_URL} target="_blank" rel="noopener noreferrer">View repository ↗</a></article><article class="card"><span class="tag">Manual download</span><h2>Choose a release asset</h2><p>Download a binary or package directly from the release page.</p><a class="button button-secondary" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">Open releases ↗</a></article></div></section>
  <section class="section section-muted"><div class="container"><div class="section-header"><span class="eyebrow">After installation</span><h2>Make your first reading list.</h2></div><div class="grid-3"><div class="card"><span class="stat-value">01</span><h3>Initialize</h3><div class="code-block">ods init .</div></div><div class="card"><span class="stat-value">02</span><h3>Ask for context</h3><div class="code-block">ods context doc.md</div></div><div class="card"><span class="stat-value">03</span><h3>Keep it healthy</h3><div class="code-block">ods serve</div></div></div></div></section>
  <section class="section section-tight"><div class="container"><div class="section-cta"><div><h2>Prefer the guided path?</h2><p>The quickstart explains the mental model and shows how to add ODS to a real workspace.</p></div><a class="button button-primary button-lg" href="/docs/quickstart">Open quickstart →</a></div></div></section>
</Layout>
