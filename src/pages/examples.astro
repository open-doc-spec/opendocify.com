description: Authentication microservice gRPC contracts and verification handlers.
ods:
  profile: api
  status: stable
  code:
    - path: proto/auth/v1/service.proto
      role: schema
    - path: src/auth/jwt_verifier.rs
      symbol: verify_token()
      role: implementation
---</code></pre>
          </div>
        </div>
      </div>

