---
import Layout from "../layouts/Layout.astro";

const examples = [
  { category: "Engineering", title: "Connect architecture to implementation", text: "Link design decisions to the functions, tests, and schemas that make them real.", command: "ods context docs/architecture/storage-engine.md" },
  { category: "Product", title: "Keep goals and acceptance criteria together", text: "Give an assistant the product context behind a feature before it changes the code.", command: "ods context specs/checkout/feature.md" },
  { category: "Compliance", title: "Trace policies without exposing secrets", text: "Use visibility keys and explicit links to build a reviewable, share-aware evidence trail.", command: "ods lint --strict compliance/" },
  { category: "Research", title: "Map notes, sources, and citations", text: "Make a bounded reading path through source notes and supporting material.", command: "ods context research/question.md" },
  { category: "DevOps", title: "Keep runbooks close to systems", text: "Connect operational guides to services, checks, and deployment scripts.", command: "ods context docs/runbooks/release.md" },
  { category: "Design systems", title: "Document decisions where teams find them", text: "Pair component guidance with the implementation and examples that keep it current.", command: "ods context docs/components/button.md" },
];
---

<Layout title="Examples and use cases — Open Document Spec (ODS)" activeNav="examples">
  <section class="page-hero"><div class="container"><div class="section-header"><span class="eyebrow">One graph, many teams</span><h1>Make the documents behind every decision easier to navigate.</h1><p class="lead">These examples show how ODS turns the relationships already present in a workspace into useful, bounded AI context.</p></div><div class="filter-row" id="example-filters"><button class="filter-button active" data-filter="all">All examples</button>{["Engineering","Product","Compliance","Research","DevOps","Design systems"].map((category) => <button class="filter-button" data-filter={category}>{category}</button>)}</div></div></section>
  <section class="section"><div class="container"><div class="grid-2" id="example-grid">{examples.map((example) => <article class="card example-card" data-category={example.category}><span class="tag">{example.category}</span><h2>{example.title}</h2><p>{example.text}</p><div class="code-block">$ {example.command}</div><a class="button button-ghost button-sm" href="/docs/quickstart">See the setup →</a></article>)}</div></div></section>
  <section class="section section-tight"><div class="container"><div class="section-cta"><div><h2>Build your own example.</h2><p>Start with one folder and let the graph grow with your documentation.</p></div><a class="button button-primary button-lg" href="/docs">Read the docs →</a></div></div></section>
  <script is:inline>
    const filterButtons = document.querySelectorAll('[data-filter]');
    const exampleCards = document.querySelectorAll('.example-card');
    filterButtons.forEach((button) => button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');
      filterButtons.forEach((item) => item.classList.toggle('active', item === button));
      exampleCards.forEach((card) => { card.hidden = filter !== 'all' && card.getAttribute('data-category') !== filter; });
    }));
  </script>
</Layout>
