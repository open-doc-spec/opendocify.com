---
// FILE: examples.astro
// Purpose: Industry Use Cases & Examples Page with Top Category Filter Bar and 16+ Real-World Industry Examples.
// Layer: Marketing page

import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import HeroGradient from "../components/HeroGradient.astro";
import { ORG_URL } from "../lib/releases";

const categories = [
  { id: "all", label: "All Examples" },
  { id: "coding", label: "Coding & Tech" },
  { id: "pharma", label: "Pharma & Health" },
  { id: "research", label: "Research & Academia" },
  { id: "legal", label: "Enterprise & Legal" },
  { id: "engineering", label: "Engineering & Aerospace" },
  { id: "design", label: "Design Systems" },
  { id: "devops", label: "DevOps & Cloud" },
  { id: "government", label: "Government & Policy" },
  { id: "fintech", label: "Finance & Fintech" },
];
---

<Layout title="16+ Industry Use Cases & Examples: Open Document Spec (ODS)" activeNav="examples">
  <!-- FULL-WIDTH END-TO-END HERO SECTION -->
  <section class="page-hero-wrapper">
    <!-- TOP ETHEREAL 2-COLOR GRADIENT BLUR BACKDROP -->
    <HeroGradient />

    <div class="page-hero-inner">
      <div class="header-section">
        <h1 class="page-title">ODS Across All Knowledge Domains</h1>
        <p class="page-subtitle">
          How different teams adopt ODS to keep their documents updated and reduce AI assistant costs by up to 94%.
        </p>
      </div>
    </div>
  </section>

  <div class="page-container">
    <!-- Industry ROI Cost Reduction Summary Chart (Minimal Graph Presentation) -->
    <div class="industry-roi-chart-box glow-card">
      <div class="roi-chart-header">
        <div class="roi-header-info">
          <h4>Estimated Industry Token & Cost Reduction</h4>
          <p class="roi-header-subtitle">
            Measured context window token savings vs. unindexed Markdown repositories (ODS DAG resolution).
          </p>
        </div>
        <span class="roi-badge">
          <span class="pulse-dot-sm" aria-hidden="true"></span>
          16 Team Use Cases
        </span>
      </div>

      <!-- Graph Surface with Axis and Reference Lines inside responsive scroll container -->
      <div class="roi-graph-scroll-wrapper">
        <div class="roi-graph-surface">
          <!-- Y-Axis Scale Lines -->
          <div class="roi-axis-lines" aria-hidden="true">
            <div class="axis-line"><span class="axis-val">100%</span></div>
            <div class="axis-line"><span class="axis-val">75%</span></div>
            <div class="axis-line"><span class="axis-val">50%</span></div>
            <div class="axis-line"><span class="axis-val">25%</span></div>
            <div class="axis-line base"><span class="axis-val">0%</span></div>
          </div>

          <!-- Columns Area -->
          <div class="roi-columns-grid">
            <!-- Col 1: Coding & Tech -->
            <div class="roi-column-item">
              <div class="col-bar-lane">
                <div class="col-bar-pillar" style="height: 94.97%;">
                  <span class="pillar-number">94.97%</span>
                </div>
              </div>
              <div class="col-meta-footer">
                <span class="col-title">Coding & Tech</span>
                <span class="col-pill-metric">-$34.8k/yr</span>
              </div>
            </div>

            <!-- Col 2: Pharma & Health -->
            <div class="roi-column-item">
              <div class="col-bar-lane">
                <div class="col-bar-pillar" style="height: 92.40%;">
                  <span class="pillar-number">92.40%</span>
                </div>
              </div>
              <div class="col-meta-footer">
                <span class="col-title">Pharma & Health</span>
                <span class="col-pill-metric">85% Faster Audit</span>
              </div>
            </div>

            <!-- Col 3: Research & Academia -->
            <div class="roi-column-item">
              <div class="col-bar-lane">
                <div class="col-bar-pillar" style="height: 96.10%;">
                  <span class="pillar-number">96.10%</span>
                </div>
              </div>
              <div class="col-meta-footer">
                <span class="col-title">Research & Academia</span>
                <span class="col-pill-metric">100% Traced</span>
              </div>
            </div>

            <!-- Col 4: Enterprise & Legal -->
            <div class="roi-column-item">
              <div class="col-bar-lane">
                <div class="col-bar-pillar" style="height: 97.50%;">
                  <span class="pillar-number">97.50%</span>
                </div>
              </div>
              <div class="col-meta-footer">
                <span class="col-title">Enterprise & Legal</span>
                <span class="col-pill-metric">Zero Leaks</span>
              </div>
            </div>

            <!-- Col 5: Defense & Security -->
            <div class="roi-column-item">
              <div class="col-bar-lane">
                <div class="col-bar-pillar" style="height: 98.20%;">
                  <span class="pillar-number">98.20%</span>
                </div>
              </div>
              <div class="col-meta-footer">
                <span class="col-title">Defense & Security</span>
                <span class="col-pill-metric">Air-Gapped</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Graph Summary Footer -->
      <div class="roi-graph-footer">
        <div class="graph-legend-item">
          <div class="legend-item-left">
            <span class="legend-indicator-dot green"></span>
            <span class="legend-label">Average Token Savings:</span>
          </div>
          <span class="legend-highlight">95.4%</span>
        </div>
        <div class="graph-legend-item">
          <div class="legend-item-left">
            <span class="legend-indicator-dot blue"></span>
            <span class="legend-label">Lookup Latency:</span>
          </div>
          <span class="legend-highlight">&lt; 5ms</span>
        </div>
        <div class="graph-legend-item">
          <div class="legend-item-left">
            <span class="legend-indicator-dot gradient-dual"></span>
            <span class="legend-label">Context Traversal:</span>
          </div>
          <span class="legend-highlight">Deterministic DAG</span>
        </div>
      </div>
    </div>

    <!-- Category Filter Pill Bar -->
    <div class="category-filter-bar">
      {categories.map((cat) => (
        <button
          class:list={["filter-btn", { active: cat.id === "all" }]}
          data-category={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Main Content: 16+ Wide Horizontal Example Cards -->
    <div class="examples-content-grid">

      <!-- 1. Software Monorepos -->
      <div class="example-card-horizontal glow-card" data-category="coding">
        <div class="card-left">
          <div class="ex-header">
            <div class="ex-icon-wrapper">
              <Icon name="code" size={20} class="ex-icon" />
            </div>
            <div class="ex-title-meta">
              <span class="ex-industry-tag">Coding & Tech</span>
              <h3>Connecting Architecture Specs to Code</h3>
            </div>
          </div>
          <p class="ex-desc">
            Connect system architecture decisions directly to concrete implementation functions and test suites without fragile line numbers.
          </p>
          <div class="ex-stats">
            <div class="stat-item">
              <span class="stat-val">94.97%</span>
              <span class="stat-lbl">Token Savings</span>
            </div>
            <div class="stat-item">
              <span class="stat-val">0 Stale Refs</span>
              <span class="stat-lbl">Maintained by CLI</span>
            </div>
          </div>
          <div class="ex-cmd">
            <span class="cmd-prompt">$</span>
            <code>ods context docs/architecture/storage-engine.md</code>
          </div>
        </div>
        <div class="card-right">
          <div class="ex-code-box">
            <div class="code-title">
              <span class="file-path">docs/architecture/storage-engine.md</span>
            </div>
            <pre class="theme-code"><code>---
description: Storage engine architecture and pool initialization logic.
owner: infra-team
ods:
  profile: architecture
  status: stable
  depends:
    - docs/architecture/database.md
  code:
    - path: src/storage/db.rs
      symbol: init_pool()
      role: implementation
    - path: tests/db_test.rs
      role: test
---</code></pre>
          </div>
        </div>
      </div>

      <!-- 2. Microservice API Specs -->
      <div class="example-card-horizontal glow-card" data-category="coding">
        <div class="card-left">
          <div class="ex-header">
            <div class="ex-icon-wrapper">
              <Icon name="plug" size={20} class="ex-icon" />
            </div>
            <div class="ex-title-meta">
              <span class="ex-industry-tag">Coding & Tech</span>
              <h3>Microservice Contract & Schema Bindings</h3>
            </div>
          </div>
          <p class="ex-desc">
            Link service interface specs directly to Protocol Buffer schemas and JWT auth handlers so AI tools generate verified client libraries.
          </p>
