---
// FILE: features.astro
// Purpose: ods-Style Product Feature Showcase driven dynamically by src/store/features.md content store.
// Layer: Marketing page

import Layout from "../layouts/Layout.astro";
import AIIcon from "../components/AIIcon.astro";
import { ORG_URL } from "../lib/releases";
import { frontmatter } from "../store/features.md";

type AIIconType = "claude" | "openai" | "cursor" | "windsurf" | "antigravity" | "grok";

interface Metric {
  val: string;
  lbl: string;
}

interface FeatureRow {
  tag: string;
  title: string;
  description: string;
  cmd: string;
  visualType: string;
  codeBoxTitle?: string;
  codeContent?: string;
  chips?: Array<{ name: string; icon: AIIconType }>;
  levels?: Array<{ num: string; text: string; active?: boolean }>;
  ragBad?: string;
  odsGood?: string;
  reverse: boolean;
}

interface BannerItem {
  icon: string;
  title: string;
  description: string;
}

interface ProfileItem {
  badge: string;
  title: string;
  headingsLabel: string;
  headings: string[];
}

interface StepItem {
  badge: string;
  title: string;
  description: string;
  active?: boolean;
}
---

<Layout title="All Core Features: Open Document Spec (ODS)" activeNav="features">
  <div class="dot-matrix-bg"></div>

  <div class="page-container">
    <!-- HEADER SECTION -->
    <div class="header-section">
      <div class="pill-badge">{frontmatter.header.pillBadge}</div>
      <h1 class="page-title">{frontmatter.header.pageTitle}</h1>
      <p class="page-subtitle" set:html={frontmatter.header.pageSubtitle}></p>
    </div>

    <!-- TOP CORE FEATURE #1 (HERO HIGHLIGHT) -->
    <section class="feature-hero-top glow-card">
      <div class="hero-feat-left">
        <span class="pill-badge-sm">{frontmatter.heroFeature.badge}</span>
        <h2>{frontmatter.heroFeature.title}</h2>
        <p set:html={frontmatter.heroFeature.description}></p>
        <div class="hero-feat-metrics">
          {frontmatter.heroFeature.metrics.map((m: Metric) => (
            <div class="m-card">
              <span class="m-val">{m.val}</span>
              <span class="m-lbl">{m.lbl}</span>
            </div>
          ))}
        </div>
        <div class="hero-cmd-box">
          <code>{frontmatter.heroFeature.cmd}</code>
        </div>
      </div>

      <div class="hero-feat-right">
        <div class="code-box-wrapper">
          <div class="code-box-title">{frontmatter.heroFeature.codeBoxTitle}</div>
          <pre class="theme-code"><code>{frontmatter.heroFeature.codeContent}</code></pre>
        </div>
      </div>
    </section>

    <!-- ALTERNATING ROW PAIR 1 -->
    <div class="feature-rows-group">
      {frontmatter.rowsGroup1.map((row: FeatureRow) => (
        <section class={`feature-row glow-card ${row.reverse ? 'reverse' : ''}`}>
          <div class="row-text">
            <span class="row-tag">{row.tag}</span>
            <h3>{row.title}</h3>
            <p set:html={row.description}></p>
            <div class="row-cmd">
              <code>{row.cmd}</code>
            </div>
          </div>
          <div class="row-visual">
            <div class="code-box-wrapper">
              <div class="code-box-title">{row.codeBoxTitle}</div>
              <pre class="theme-code"><code>{row.codeContent}</code></pre>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- CORE HIGHLIGHT #1 (AUTO-HEALING DAEMON) -->
    <section class="feature-big-banner glow-card">
      <div class="big-banner-header">
        <span class="banner-badge">{frontmatter.banner1.badge}</span>
        <h2>{frontmatter.banner1.title}</h2>
        <p>{frontmatter.banner1.description}</p>
      </div>

      <div class="big-banner-grid">
        {frontmatter.banner1.items.map((item: BannerItem) => (
          <div class="banner-item">
            <div class="banner-item-icon">
              {item.icon === 'link' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                </svg>
              )}
              {item.icon === 'activity' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                </svg>
              )}
              {item.icon === 'shield-check' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              )}
            </div>
            <h4>{item.title}</h4>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ALTERNATING ROW PAIR 2 -->
    <div class="feature-rows-group">
      {frontmatter.rowsGroup2.map((row: FeatureRow) => (
        <section class={`feature-row glow-card ${row.reverse ? 'reverse' : ''}`}>
          <div class="row-text">
            <span class="row-tag">{row.tag}</span>
            <h3>{row.title}</h3>
            <p set:html={row.description}></p>
            <div class="row-cmd">
              <code>{row.cmd}</code>
            </div>
          </div>
          <div class="row-visual">
            {row.visualType === 'ai-chips' && row.chips && (
              <div class="ai-chips-box">
                {row.chips.map((chip: { name: string; icon: AIIconType }) => (
                  <div class="ai-chip-item"><AIIcon name={chip.icon} size={24} /> <span>{chip.name}</span></div>
                ))}
              </div>
            )}
            {row.visualType === 'levels-stack' && row.levels && (
              <div class="levels-mini-stack">
                {row.levels.map((lvl: { num: string; text: string; active?: boolean }) => (
                  <div class={`l-step ${lvl.active ? 'active' : ''}`}><span>{lvl.num}</span> {lvl.text}</div>
                ))}
              </div>
            )}
          </div>
        </section>
      ))}
    </div>

    <!-- CORE HIGHLIGHT #2 (ENTERPRISE PROFILES) -->
    <section class="feature-big-banner glow-card section-ods-templates">
      <div class="big-banner-header">
        <span class="banner-badge">{frontmatter.bannerTemplates.badge}</span>
        <h2>{frontmatter.bannerTemplates.title}</h2>
        <p>{frontmatter.bannerTemplates.description}</p>
      </div>

      <div class="profiles-section-wrapper">
        <div class="profiles-2x2-grid">
          {frontmatter.bannerTemplates.profiles.map((p: ProfileItem) => (
            <div class="p-card">
              <span class="p-badge">{p.badge}</span>
              <h4>{p.title}</h4>
              <div class="headings-group">
                <span class="headings-label">{p.headingsLabel}</span>
                <div class="heading-tags">
                  {p.headings.map((h: string) => (
                    <code class="h-tag">{h}</code>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="p-card custom-featured-card">
          <div class="custom-card-header">
            <span class="p-badge">{frontmatter.bannerTemplates.customTemplate.badge}</span>
            <h4>{frontmatter.bannerTemplates.customTemplate.title}</h4>
          </div>
          <div class="headings-group">
            <span class="headings-label">{frontmatter.bannerTemplates.customTemplate.headingsLabel}</span>
            <div class="heading-tags">
              {frontmatter.bannerTemplates.customTemplate.headings.map((h: string) => (
                <code class="h-tag">{h}</code>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="ladder-graphic-box">
        <h4 class="ladder-title">{frontmatter.bannerTemplates.ladder.title}</h4>
        <div class="ladder-timeline">
          {frontmatter.bannerTemplates.ladder.steps.map((step: StepItem) => (
            <div class={`timeline-step ${step.active ? 'step-active' : ''}`}>
              <span class={`step-badge ${step.active ? 'active-badge' : ''}`}>{step.badge}</span>
              <h5 class="l-lbl">{step.title}</h5>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ALTERNATING ROW PAIR 3 -->
    <div class="feature-rows-group">
      {frontmatter.rowsGroup3.map((row: FeatureRow) => (
        <section class={`feature-row glow-card ${row.reverse ? 'reverse' : ''}`}>
          <div class="row-text">
            <span class="row-tag">{row.tag}</span>
            <h3>{row.title}</h3>
            <p set:html={row.description}></p>
            <div class="row-cmd">
              <code>{row.cmd}</code>
            </div>
          </div>
          <div class="row-visual">
            {row.visualType === 'code' && (
              <div class="code-box-wrapper">
                <div class="code-box-title">{row.codeBoxTitle}</div>
                <pre class="theme-code"><code>{row.codeContent}</code></pre>
              </div>
            )}
            {row.visualType === 'rag-vs' && (
              <div class="rag-vs-box">
                <div class="rag-bad">{row.ragBad}</div>
                <div class="ods-good">{row.odsGood}</div>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>

    <!-- CORE HIGHLIGHT #3 (SOC2 PRIVACY SHIELD) -->
    <section class="feature-big-banner glow-card">
      <div class="big-banner-header">
        <span class="banner-badge">{frontmatter.bannerSecurity.badge}</span>
        <h2>{frontmatter.bannerSecurity.title}</h2>
        <p>{frontmatter.bannerSecurity.description}</p>
      </div>

      <div class="big-banner-grid">
        {frontmatter.bannerSecurity.items.map((item: BannerItem) => (
          <div class="banner-item">
            <div class="banner-item-icon">
              {item.icon === 'lock' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              )}
              {item.icon === 'eye-off' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                  <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
              )}
              {item.icon === 'refresh-cw' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 2v6h-6"></path>
                  <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
                  <path d="M3 22v-6h6"></path>
                  <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
                </svg>
              )}
            </div>
            <h4>{item.title}</h4>
            <p set:html={item.description}></p>
          </div>
        ))}
      </div>
    </section>

    <!-- ALTERNATING ROW PAIR 4 -->
    <div class="feature-rows-group">
      {frontmatter.rowsGroup4.map((row: FeatureRow) => (
        <section class={`feature-row glow-card ${row.reverse ? 'reverse' : ''}`}>
          <div class="row-text">
            <span class="row-tag">{row.tag}</span>
            <h3>{row.title}</h3>
            <p set:html={row.description}></p>
            <div class="row-cmd">
              <code>{row.cmd}</code>
            </div>
          </div>
          <div class="row-visual">
            <div class="code-box-wrapper">
              <div class="code-box-title">{row.codeBoxTitle}</div>
              <pre class="theme-code"><code>{row.codeContent}</code></pre>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- CTA & Key Reference Redirection Section -->
    <div class="features-bottom-cta glow-card">
      <div class="cta-left">
        <h2>{frontmatter.bottomCTA.title}</h2>
        <p>{frontmatter.bottomCTA.subtitle}</p>
      </div>
      <div class="cta-btns">
        <a href={frontmatter.bottomCTA.primaryBtnLink} class="primary-btn">{frontmatter.bottomCTA.primaryBtnText}</a>
        <a href={ORG_URL} target="_blank" rel="noopener noreferrer" class="secondary-btn">{frontmatter.bottomCTA.secondaryBtnText}</a>
      </div>
    </div>

  </div>
</Layout>

<style>
  .page-container {
    width: min(94vw, 1200px);
    margin: 0 auto;
    padding-top: var(--space-48);
    padding-bottom: var(--space-64);
    position: relative;
    z-index: 1;
  }

  .header-section {
    text-align: center;
    max-width: 820px;
    margin: 0 auto var(--space-32);
  }

  .pill-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: var(--space-4) var(--space-12);
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    margin-bottom: var(--space-16);
  }

  .page-title {
    font-size: clamp(2.4rem, 5.2vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--fg);
    margin-bottom: var(--space-16);
    line-height: 1.15;
  }

  .page-subtitle {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--fg-muted);
    line-height: 1.6;
  }

  /* ── TOP PARETO HERO FEATURE ── */

  .feature-hero-top {
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-48) var(--space-32);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-32);
    align-items: center;
    margin-bottom: var(--space-64) !important;
  }

  .pill-badge-sm {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: var(--space-4) var(--space-8);
    background: var(--action-bg);
    color: var(--action-fg);
    border-radius: var(--radius-pill);
    display: inline-block;
    margin-bottom: var(--space-16);
  }

  .hero-feat-left h2 {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--fg);
    margin-bottom: var(--space-12);
    line-height: 1.2;
  }

  .hero-feat-left p {
    font-size: 0.95rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin-bottom: var(--space-24);
  }

  .hero-feat-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-16);
    margin-bottom: var(--space-24);
  }

  .m-card {
    background: var(--nested-card-bg);
    border: var(--border);
    padding: var(--space-8) var(--space-12);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
  }

  .m-val {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--fg);
  }

  .m-lbl {
    font-size: 0.7rem;
    color: var(--fg-dim);
  }

  .hero-cmd-box {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--nested-card-bg);
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-sm);
    border: var(--border);
    color: var(--fg);
    overflow-x: auto;
    white-space: nowrap;
    max-width: 100%;
  }

  /* ── ALTERNATING FEATURE ROWS (ZIG-ZAG) ── */

  .feature-rows-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
    margin-bottom: var(--space-64) !important;
  }

  .feature-row {
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-48) var(--space-32);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-32);
    align-items: center;
    margin-bottom: 0 !important;
  }

  .feature-row.reverse {
    grid-template-columns: 1fr 1fr;
  }

  .feature-row.reverse .row-text {
    order: 2;
  }

  .feature-row.reverse .row-visual {
    order: 1;
  }

  .row-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-dim);
    display: block;
    margin-bottom: var(--space-4);
  }

  .row-text h3 {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: var(--space-8);
  }

  .row-text p {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin-bottom: var(--space-16);
  }

  .row-cmd {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--fg-muted);
    background: var(--nested-card-bg);
    padding: var(--space-8) var(--space-12);
    border-radius: var(--radius-sm);
    border: var(--border);
    display: inline-block;
    overflow-x: auto;
    white-space: nowrap;
    max-width: 100%;
  }

  .hero-feat-right,
  .row-visual {
    min-width: 0;
    width: 100%;
  }

  .row-cmd code {
    color: var(--fg);
  }

  /* ── BIG PARETO HIGHLIGHT BANNERS ── */

  .feature-big-banner {
    background: var(--card-bg);
    border: var(--border);
    border-radius: var(--radius-outer) !important;
    padding: var(--space-56) var(--space-48) !important;
    margin-bottom: var(--space-64) !important;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .banner-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: var(--space-6) var(--space-14);
    background: var(--action-bg);
    color: var(--action-fg);
    border-radius: var(--radius-pill);
    display: inline-block;
    margin-bottom: var(--space-16);
  }

  .big-banner-header h2 {
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.015em;
    margin-bottom: var(--space-8);
  }

  .big-banner-header p {
    font-size: 0.95rem;
    color: var(--fg-muted);
    max-width: 680px;
    margin: 0 auto var(--space-36);
    line-height: 1.55;
  }

  .big-banner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-24);
    text-align: left;
  }

  .banner-item {
    background: var(--nested-card-bg) !important;
    border: var(--border) !important;
    border-radius: var(--radius-child) !important;
    padding: var(--space-32) var(--space-28) !important;
    display: flex !important;
    flex-direction: column !important;
    gap: var(--space-16) !important;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease !important;
    box-sizing: border-box;
    height: 100%;
  }

  .banner-item:hover {
    transform: translateY(-4px) !important;
    border-color: var(--fg-muted) !important;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08) !important;
  }

  .banner-item-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--card-bg);
    border: var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--fg);
    margin-bottom: var(--space-6);
    flex-shrink: 0;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .banner-item:hover .banner-item-icon {
    background: var(--action-bg);
    color: var(--action-fg);
    transform: scale(1.05);
  }

  .banner-item h4 {
    font-size: 1.05rem !important;
    font-weight: 600 !important;
    color: var(--fg) !important;
    margin: 0 !important;
    line-height: 1.35 !important;
  }

  .banner-item p {
    font-size: 0.875rem !important;
    color: var(--fg-muted) !important;
    line-height: 1.55 !important;
    margin: 0 !important;
  }

  .banner-item code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 2px 6px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    color: var(--fg);
  }

  /* ── Redesigned ODS Templates Section (Strict Theme Tokens) ── */

  .profiles-section-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    margin-bottom: var(--space-32);
  }

  .profiles-2x2-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-20);
    text-align: left;
  }

  .p-card {
    background: var(--nested-card-bg);
    border: var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-24);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .p-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    background: var(--action-bg);
    color: var(--action-fg);
    border-radius: var(--radius-pill);
    display: inline-block;
    letter-spacing: 0.02em;
  }

  .p-card h4 {
