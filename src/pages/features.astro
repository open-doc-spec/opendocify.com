---
import Layout from '@/layouts/Layout.astro';
import Features from '@/components/sections/Features.astro';
import CTA from '@/components/sections/CTA.astro';

const features = [
  { icon: 'zap', title: 'Smart reading lists', description: 'Resolve a document into the smallest useful set of linked pages, references, and implementation files.' },
  { icon: 'link', title: 'Code connections', description: 'Point from prose to the exact symbol, schema, or test that gives it meaning.' },
  { icon: 'shield', title: 'Visibility controls', description: 'Mark documents as public, org, or private so exports respect the boundary you set.' },
  { icon: 'chart', title: 'Progressive adoption', description: 'Move from plain Markdown to richer validation at your own pace, from Level 0 through Level 3.' },
  { icon: 'link', title: 'Auto-healing links', description: 'Run the local watcher to repair references when documents move or change names.' },
  { icon: 'shield', title: 'Open standard', description: 'ODS works on top of text files and version control. There is no hosted index to migrate away from later.' },
];
---

<Layout title="Features — Open Document Spec (ODS)" activeNav="features">
  <section class="px-6 py-20 md:py-28"><div class="container mx-auto max-w-5xl"><div class="flex flex-col gap-5" data-animate="slide-left"><span class="inline-flex w-fit rounded-full border border-border bg-muted px-4 py-1.5 font-mono text-sm text-muted-foreground">A document graph, without the platform lock-in</span><h1 class="max-w-4xl text-5xl font-bold leading-tight tracking-tight md:text-7xl">Everything AI needs to read your workspace with precision.</h1><p class="max-w-2xl text-lg text-muted-foreground md:text-xl">ODS adds explicit relationships, profiles, and validation to ordinary Markdown. The result is a faster, more trustworthy context layer for every assistant.</p></div></div></section>
  <Features title="Start small. Add structure as the workspace grows." subtitle="The building blocks are ordinary files, explicit links, and a fast local CLI." features={features} />
  <section class="section-muted px-6 py-20"><div class="container mx-auto max-w-5xl"><div class="grid gap-6 md:grid-cols-2"><div class="rounded-lg border bg-card p-6" data-animate="slide-left"><h2 class="text-2xl font-semibold">A standard your team owns</h2><p class="mt-3 text-muted-foreground">No hidden database or complex format. ODS works on standard text files that remain portable and inspectable.</p><pre class="mt-5 rounded-md border bg-muted p-4 font-mono text-sm text-muted-foreground">profile: spec
## Summary
## Requirements</pre></div><div class="rounded-lg border bg-card p-6" data-animate="slide-right"><h2 class="text-2xl font-semibold">Works with your tools</h2><p class="mt-3 text-muted-foreground">The CLI and plain files fit into editors, terminals, CI, and AI skills without a hosted workflow.</p><div class="mt-5 flex flex-wrap gap-2"><span class="rounded-full border px-3 py-1 text-xs">Claude</span><span class="rounded-full border px-3 py-1 text-xs">Cursor</span><span class="rounded-full border px-3 py-1 text-xs">Codex</span><span class="rounded-full border px-3 py-1 text-xs">Gemini</span></div></div></div></div></section>
  <CTA title="See the system in action." description="Use the examples to explore how the same document graph works across technical, research, compliance, and product teams." cta={{ href: '/examples', label: 'Explore examples →' }} />
</Layout>
