<script is:inline>
  (function () {
    function getThemePreference() {
      const stored = localStorage.getItem('theme') || localStorage.getItem('ods-theme');
      if (stored === 'light' || stored === 'dark') {
        return stored;
      }
      return 'dark';
    }

    function applyTheme(targetDoc) {
      const doc = targetDoc || document;
      if (!doc || !doc.documentElement) return;
      const theme = getThemePreference();
      const isDark = theme === 'dark';
      doc.documentElement.classList.toggle('dark', isDark);
      doc.documentElement.dataset.theme = theme;
    }

    // Apply synchronously on initial document load to prevent theme flash
    applyTheme(document);

    // Apply on astro:before-swap so incoming document has the active theme applied before DOM swap
    document.addEventListener('astro:before-swap', function (event) {
      if (event && event.newDocument) {
        applyTheme(event.newDocument);
      }
    });

    // Re-verify on astro:after-swap
    document.addEventListener('astro:after-swap', function () {
      applyTheme(document);
    });
  })();
</script>
