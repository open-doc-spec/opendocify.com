<script is:inline>
  (function () { const theme = localStorage.getItem('theme') || localStorage.getItem('ods-theme'); const dark = theme ? theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches; document.documentElement.classList.toggle('dark', dark); document.documentElement.dataset.theme = dark ? 'dark' : 'light'; })();
</script>
