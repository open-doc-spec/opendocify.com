---
interface Props { title: string; subtitle: string; tagline?: string; primaryCta?: { href: string; label: string }; secondaryCta?: { href: string; label: string }; }
const { title, subtitle, tagline, primaryCta, secondaryCta } = Astro.props;
---

<section class="min-h-[70vh] overflow-hidden px-6 py-16 md:py-24">
  <div class="container mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2 md:gap-16">
    <div class="flex flex-col gap-6" data-animate="slide-left">
      {tagline && <div class="inline-flex w-fit items-center gap-2 rounded-full border border-border bg-muted px-4 py-1.5 font-mono text-sm text-muted-foreground"><span class="inline-block h-2 w-2 rounded-full bg-primary opacity-80" aria-hidden="true"></span>{tagline}</div>}
      <h1 class="text-5xl font-bold leading-tight tracking-tight md:text-6xl">{title}</h1>
      <p class="max-w-lg text-lg text-muted-foreground md:text-xl" set:html={subtitle}></p>
      {(primaryCta || secondaryCta) && <div class="mt-2 flex flex-col gap-4 sm:flex-row"><>{primaryCta && <a href={primaryCta.href} class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition hover:bg-primary/90">{primaryCta.label} <span class="ml-2">→</span></a>}{secondaryCta && <a href={secondaryCta.href} class="inline-flex h-12 items-center justify-center rounded-md border border-input bg-background px-8 text-sm font-medium transition hover:bg-accent hover:text-accent-foreground">{secondaryCta.label}</a>}</></div>}
    </div>
    <div data-animate="slide-right" data-delay="2"><slot /></div>
  </div>
</section>
