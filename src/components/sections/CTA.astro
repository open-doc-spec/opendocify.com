---
interface Props { title: string; description: string; cta: { href: string; label: string }; }
const { title, description, cta } = Astro.props;
---

<section class="px-6 py-24"><div class="container mx-auto max-w-5xl"><div class="rounded-lg border bg-muted/50 p-8 text-center md:p-12" data-animate="scale"><h2 class="text-3xl font-bold leading-[1.1] md:text-4xl">{title}</h2><p class="mx-auto mt-4 max-w-[600px] text-muted-foreground">{description}</p><a href={cta.href} class="mt-6 inline-flex h-11 items-center justify-center rounded-full bg-primary px-8 text-sm font-medium text-primary-foreground transition hover:bg-primary/90">{cta.label}</a></div></div></section>
