---
import Logo from './Logo.astro';
import { ORG_URL, REPO_URL } from '../lib/releases';
---

<footer class="site-footer border-t bg-background text-foreground" aria-label="Site footer">
  <div class="container mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.5fr_repeat(3,1fr)]">
      <div class="footer-brand">
        <Logo />
        <p class="mt-4 max-w-xs text-sm text-muted-foreground">
          Human-First Document Graphs for Enterprise AI. Cutting prompt token usage by up to 94% with zero vendor lock-in.
        </p>
      </div>

      <nav aria-labelledby="footer-heading-product">
        <h3 id="footer-heading-product" class="footer-title">
          Product
        </h3>
        <ul class="footer-links list-none p-0 m-0 grid gap-2 text-sm text-muted-foreground">
          <li><a href="/features" class="transition-colors hover:text-foreground">Features</a></li>
          <li><a href="/examples" class="transition-colors hover:text-foreground">Use cases</a></li>
          <li><a href="/pricing" class="transition-colors hover:text-foreground">Pricing</a></li>
          <li><a href="/changelog" class="transition-colors hover:text-foreground">Changelog</a></li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-heading-learn">
        <h3 id="footer-heading-learn" class="footer-title">
          Learn
        </h3>
        <ul class="footer-links list-none p-0 m-0 grid gap-2 text-sm text-muted-foreground">
          <li><a href="/docs" class="transition-colors hover:text-foreground">Documentation</a></li>
          <li><a href="/spec" class="transition-colors hover:text-foreground">Specification</a></li>
          <li><a href="/download" class="transition-colors hover:text-foreground">Install ODS</a></li>
          <li><a href="/privacy" class="transition-colors hover:text-foreground">Privacy</a></li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-heading-opensource">
        <h3 id="footer-heading-opensource" class="footer-title">
          Open source
        </h3>
        <ul class="footer-links list-none p-0 m-0 grid gap-2 text-sm text-muted-foreground">
          <li><a href={ORG_URL} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground inline-flex items-center gap-1">GitHub <span aria-hidden="true">↗</span></a></li>
          <li><a href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground inline-flex items-center gap-1">Issue tracker <span aria-hidden="true">↗</span></a></li>
          <li><a href={`${REPO_URL}/releases`} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-foreground inline-flex items-center gap-1">Releases <span aria-hidden="true">↗</span></a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom mt-10 flex flex-col gap-2 border-t pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <span>© 2026 Open Document Spec Project. Apache 2.0 License.</span>
      <span>Built for humans and AI.</span>
    </div>
  </div>
</footer>

<style>
  .footer-title {
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text, inherit);
  }
</style>
