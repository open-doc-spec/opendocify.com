---
import Logo from './Logo.astro';
import { REPO_URL } from '../lib/releases';
---

<footer class="border-t"><div class="container mx-auto max-w-6xl px-4 py-12 sm:px-6"><div class="grid gap-10 md:grid-cols-[1.5fr_repeat(3,1fr)]"><div><Logo /><p class="mt-4 max-w-xs text-sm text-muted-foreground">Human-First Document Graphs for Enterprise AI. Cutting prompt token usage by up to 94% with zero vendor lock-in.</p></div><div><h2 class="mb-3 text-xs font-semibold uppercase tracking-wider">Product</h2><nav class="grid gap-2 text-sm text-muted-foreground"><a href="/features" class="hover:text-foreground">Features</a><a href="/examples" class="hover:text-foreground">Use cases</a><a href="/pricing" class="hover:text-foreground">Pricing</a><a href="/changelog" class="hover:text-foreground">Changelog</a></nav></div><div><h2 class="mb-3 text-xs font-semibold uppercase tracking-wider">Learn</h2><nav class="grid gap-2 text-sm text-muted-foreground"><a href="/docs" class="hover:text-foreground">Documentation</a><a href="/spec" class="hover:text-foreground">Specification</a><a href="/download" class="hover:text-foreground">Install ODS</a><a href="/privacy" class="hover:text-foreground">Privacy</a></nav></div><div><h2 class="mb-3 text-xs font-semibold uppercase tracking-wider">Open source</h2><nav class="grid gap-2 text-sm text-muted-foreground"><a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="hover:text-foreground">GitHub ↗</a><a href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer" class="hover:text-foreground">Issue tracker ↗</a><a href={`${REPO_URL}/releases`} target="_blank" rel="noopener noreferrer" class="hover:text-foreground">Releases ↗</a></nav></div></div><div class="mt-10 flex flex-col gap-2 border-t pt-4 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"><span>© 2026 Open Document Spec Project. Apache 2.0 License.</span><span>Built for humans and AI.</span></div></div></footer>
