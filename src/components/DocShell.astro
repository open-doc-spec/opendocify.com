---
import Layout from "../layouts/Layout.astro";

interface Heading { depth: number; slug: string; text: string; }
interface DocEntry { id: string; data: { title?: string; description?: string; status?: string; order?: number; ods?: Record<string, any>; [key: string]: any; }; }
interface Props { collection: "docs" | "specs"; currentEntry: DocEntry; allEntries: DocEntry[]; Content: any; headings: Heading[]; }

const { collection, currentEntry, allEntries, Content, headings } = Astro.props;
const normalized = (entry: DocEntry) => (entry.id || "").replace(/\\/g, "/");
const slugFor = (entry: DocEntry) => normalized(entry).replace(/\.(md|mdx)$/, "");
const titleFor = (entry: DocEntry) => entry.data.title || slugFor(entry).split("/").pop()?.replace(/^\d+-/, "").replace(/-/g, " ") || entry.id;
const sortedEntries = [...allEntries].sort((a, b) => {
  const orderA = typeof a.data?.order === "number" ? a.data.order : 999;
  const orderB = typeof b.data?.order === "number" ? b.data.order : 999;
  return orderA - orderB || normalized(a).localeCompare(normalized(b));
});

interface Category { name: string; items: DocEntry[]; }
const categories: Category[] = [];
if (collection === "docs") {
  const core = sortedEntries.filter((entry) => !normalized(entry).includes("/") && (entry.data?.order ?? 99) < 8);
  const reference = sortedEntries.filter((entry) => !normalized(entry).includes("/") && (entry.data?.order ?? 99) >= 8);
  const useCases = sortedEntries.filter((entry) => normalized(entry).startsWith("use-cases/"));
  if (core.length) categories.push({ name: "Core guides", items: core });
  if (reference.length) categories.push({ name: "Reference & ops", items: reference });
  if (useCases.length) categories.push({ name: "Use cases", items: useCases });
} else {
  for (const [prefix, name] of [["ods/", "ODS"], ["okf/", "OKF"], ["skills/", "Skills"]] as const) {
    const items = sortedEntries.filter((entry) => normalized(entry).startsWith(prefix) && !normalized(entry).split("/").pop()?.startsWith("index"));
    if (items.length) categories.push({ name, items });
  }
}
if (!categories.length) categories.push({ name: collection === "docs" ? "All guides" : "All specs", items: sortedEntries });

const currentId = normalized(currentEntry);
const currentIndex = sortedEntries.findIndex((entry) => normalized(entry) === currentId);
const prevEntry = currentIndex > 0 ? sortedEntries[currentIndex - 1] : null;
const nextEntry = currentIndex >= 0 && currentIndex < sortedEntries.length - 1 ? sortedEntries[currentIndex + 1] : null;
const docTitle = titleFor(currentEntry);
const docDescription = currentEntry.data.description || "";
const docStatus = currentEntry.data.status || currentEntry.data.ods?.status || "active";
const docProfile = currentEntry.data.ods?.profile || (collection === "docs" ? "guide" : "spec");
---

<Layout title={`${docTitle} — ODS ${collection === "docs" ? "Documentation" : "Specification"}`} description={docDescription || `Open Document Spec ${collection === "docs" ? "documentation" : "specification"}: ${docTitle}.`} activeNav={collection === "docs" ? "docs" : "spec"}>
  <div class="container docs-layout">
    <aside class="docs-sidebar">
      <span class="eyebrow">{collection === "docs" ? "MDX docs" : "Spec files"}</span>
      <h2>{collection === "docs" ? "User guides" : "Specification"}</h2>
      <nav aria-label={`${collection} navigation`}>
        {categories.map((category) => <div class="sidebar-group"><div class="sidebar-group-title">{category.name}</div>{category.items.map((entry) => <a class:list={["sidebar-link", { active: normalized(entry) === currentId }]} href={`/${collection}/${slugFor(entry)}`}>{titleFor(entry)}</a>)}</div>)}
      </nav>
    </aside>

    <article class="doc-article">
      <div class="doc-breadcrumbs"><a href="/">Home</a><span>/</span><a href={`/${collection}`}>{collection === "docs" ? "Docs" : "Spec"}</a><span>/</span><span>{docTitle}</span></div>
      <header class="doc-article-header"><span class="eyebrow">{collection === "docs" ? "Guide" : "Specification"}</span><h1>{docTitle}</h1><div class="doc-meta"><span class="tag">{docStatus}</span><span class="tag">profile: {docProfile}</span>{currentId.endsWith(".mdx") && <span class="tag">MDX</span>}</div>{docDescription && <p class="doc-description">{docDescription}</p>}</header>
      <div class="markdown-body"><Content /></div>
      <footer class="doc-footer-nav">
        {prevEntry ? <a class="doc-nav-card" href={`/${collection}/${slugFor(prevEntry)}`}><span class="doc-nav-direction">← Previous</span><span class="doc-nav-title">{titleFor(prevEntry)}</span></a> : <div></div>}
        {nextEntry ? <a class="doc-nav-card next" href={`/${collection}/${slugFor(nextEntry)}`}><span class="doc-nav-direction">Next →</span><span class="doc-nav-title">{titleFor(nextEntry)}</span></a> : <div></div>}
      </footer>
    </article>

    <aside class="docs-outline"><div class="outline-title">On this page</div>{headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4).map((heading) => <a class:list={["outline-link", `depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>)}</aside>
  </div>
</Layout>
