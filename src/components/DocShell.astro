---
import Layout from "../layouts/Layout.astro";
import { publicCollectionPath, LEARN_DOC_IDS, isUnpublishedSpec, specNavRank, learnNavRank } from "../lib/doc-links";

interface Heading { depth: number; slug: string; text: string; }
interface DocEntry { id: string; data: { title?: string; description?: string; status?: string; order?: number; ods?: Record<string, any>; [key: string]: any; }; }
interface Props { collection: "docs" | "specs"; currentEntry: DocEntry; allEntries: DocEntry[]; Content: any; headings: Heading[]; }

const { collection, currentEntry, allEntries, Content, headings } = Astro.props;
const collectionPath = publicCollectionPath(collection);
const normalized = (entry: DocEntry) => (entry.id || "").replace(/\\/g, "/");
const slugFor = (entry: DocEntry) => normalized(entry).replace(/\.(md|mdx)$/, "");
const slugLabel = (entry: DocEntry) => slugFor(entry).split("/").pop()?.replace(/^\d+-/, "").replace(/-/g, " ") || entry.id;
const titleFor = (entry: DocEntry) => entry.data.title || slugLabel(entry);
const currentSlug = slugFor(currentEntry);
const currentDir = currentSlug.split("/").slice(0, -1).join("/");
const docPath = `/${collectionPath}/${currentSlug}`;
const leafFor = (entry: DocEntry) => normalized(entry).split("/").pop()?.replace(/\.(md|mdx)$/, "") || "";
const visibleEntries = collection === "specs" ? allEntries.filter((entry) => !isUnpublishedSpec(normalized(entry))) : allEntries;
const sortedEntries = [...visibleEntries].sort((a, b) => {
  const orderA = typeof a.data?.order === "number" ? a.data.order : 999;
  const orderB = typeof b.data?.order === "number" ? b.data.order : 999;
  if (orderA !== orderB) return orderA - orderB;
  if (collection === "specs") {
    const rank = specNavRank(normalized(a)) - specNavRank(normalized(b));
    if (rank !== 0) return rank;
  }
  if (collection === "docs" && (LEARN_DOC_IDS.has(leafFor(a)) || LEARN_DOC_IDS.has(leafFor(b)))) {
    const rank = learnNavRank(normalized(a)) - learnNavRank(normalized(b));
    if (rank !== 0) return rank;
  }
  return normalized(a).localeCompare(normalized(b));
});

interface Category { name: string; items: DocEntry[]; }
const categories: Category[] = [];
if (collection === "docs") {
  const idOf = (entry: DocEntry) => {
    const leaf = normalized(entry).split("/").pop() || normalized(entry);
    return leaf.replace(/\.(md|mdx)$/, "");
  };
  const learn = sortedEntries.filter((entry) => LEARN_DOC_IDS.has(idOf(entry)));
  const useCases = sortedEntries.filter((entry) => normalized(entry).startsWith("use-cases/"));
  const product = sortedEntries.filter((entry) => !LEARN_DOC_IDS.has(idOf(entry)) && !normalized(entry).startsWith("use-cases/"));
  const productCore = product.filter((entry) => !normalized(entry).includes("/") && (entry.data?.order ?? 99) < 8);
  const productRef = product.filter((entry) => normalized(entry).includes("/") || (entry.data?.order ?? 99) >= 8);
  if (learn.length) categories.push({ name: "Learn ODS", items: learn });
  if (productCore.length) categories.push({ name: "Product guides", items: productCore });
  if (productRef.length) categories.push({ name: "Reference & ops", items: productRef });
  if (useCases.length) categories.push({ name: "Use cases", items: useCases });
} else {
  for (const [prefix, name] of [["ods/", "ODS"], ["okf/", "OKF"], ["skills/", "Skills"]] as const) {
    const items = sortedEntries.filter((entry) => normalized(entry).startsWith(prefix) && !isUnpublishedSpec(normalized(entry)));
    if (items.length) categories.push({ name, items });
  }
}
if (!categories.length) categories.push({ name: collection === "docs" ? "All guides" : "All specs", items: sortedEntries });

const currentId = normalized(currentEntry);
const currentIndex = sortedEntries.findIndex((entry) => normalized(entry) === currentId);
const prevEntry = currentIndex > 0 ? sortedEntries[currentIndex - 1] : null;
const nextEntry = currentIndex >= 0 && currentIndex < sortedEntries.length - 1 ? sortedEntries[currentIndex + 1] : null;
const firstHeading = headings.find((heading) => heading.depth === 1)?.text;
const docTitle = currentEntry.data.title || firstHeading || slugLabel(currentEntry);
const docDescription = currentEntry.data.description || "";
const skipDuplicateTitle = Boolean(firstHeading && firstHeading === docTitle);
---

<Layout title={`${docTitle} — ODS ${collection === "docs" ? "Documentation" : "Specification"}`} description={docDescription || `Open Document Spec ${collection === "docs" ? "documentation" : "specification"}: ${docTitle}.`} activeNav={collection === "docs" ? "docs" : "spec"} shell="docs">
  <div class="container docs-layout">
    <aside class="docs-sidebar">
      <details class="docs-sidebar-details" open>
        <summary class="docs-sidebar-summary">
          <span class="docs-sidebar-summary-title">{collection === "docs" ? "User guides" : "Specification"}</span>
          <span class="docs-sidebar-summary-current">{docTitle}</span>
          <span class="docs-sidebar-summary-icon" aria-hidden="true">⌄</span>
        </summary>
        <div class="docs-sidebar-content">
          <p class="docs-sidebar-heading">{collection === "docs" ? "User guides" : "Modules"}</p>
          <nav aria-label={`${collection} navigation`}>
            {categories.map((category) => <div class="sidebar-group"><div class="sidebar-group-title">{category.name}</div>{category.items.map((entry) => <a class:list={["sidebar-link", { active: normalized(entry) === currentId }]} href={`/${collectionPath}/${slugFor(entry)}`}>{slugLabel(entry)}</a>)}</div>)}
          </nav>
        </div>
      </details>
    </aside>

    <article class="doc-article">
      <div class="doc-breadcrumbs"><a href="/">Home</a><span>/</span><a href={`/${collectionPath}`}>{collection === "docs" ? "Docs" : "Spec"}</a><span>/</span><span>{slugLabel(currentEntry)}</span></div>
      <header class="doc-article-header">
        <h1>{docTitle}</h1>
        {docDescription && <p class="doc-description">{docDescription}</p>}
      </header>
      <div
        class:list={["markdown-body", skipDuplicateTitle && "markdown-body-skip-h1"]}
        data-doc-root={`/${collectionPath}`}
        data-doc-dir={currentDir}
        data-doc-path={docPath}
      ><Content /></div>
      <footer class="doc-footer-nav">
        {prevEntry ? <a class="doc-nav-card" href={`/${collectionPath}/${slugFor(prevEntry)}`}><span class="doc-nav-direction">← Previous</span><span class="doc-nav-title">{titleFor(prevEntry)}</span></a> : <div></div>}
        {nextEntry ? <a class="doc-nav-card next" href={`/${collectionPath}/${slugFor(nextEntry)}`}><span class="doc-nav-direction">Next →</span><span class="doc-nav-title">{titleFor(nextEntry)}</span></a> : <div></div>}
      </footer>
    </article>

    <aside class="docs-outline"><div class="outline-title">On this page</div>{headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4).map((heading) => <a class:list={["outline-link", `depth-${heading.depth}`]} href={`${docPath}#${heading.slug}`}>{heading.text}</a>)}</aside>
  </div>
</Layout>

<script is:inline>
  const GUIDE_ROUTES = {
    '': '/docs/learn',
    README: '/docs/learn',
    intro: '/docs/learn',
    '00-why-ods': '/docs/00-why-ods',
    '01-first-document': '/docs/01-first-document',
    '02-pick-a-shape': '/docs/02-pick-a-shape',
    '03-link-documents': '/docs/03-link-documents',
    '04-bind-code-and-files': '/docs/04-bind-code-and-files',
    '05-ai-reading-list': '/docs/05-ai-reading-list',
    '06-run-the-workspace': '/docs/06-run-the-workspace',
    '07-extend-ods': '/docs/07-extend-ods',
    'decision-cards': '/docs/decision-cards',
    faq: '/docs/faq',
    mistakes: '/docs/mistakes',
  };
  const HASH_ALIASES = {
    '3-the-3-tier-metadata-architecture': '3-the-3-tier-layering-architecture',
    '5-unknown-content-behavior': '6-unknown-content-behavior-normative',
    '3-graph-edge-types-depends-vs-related': '3-the-two-graph-edge-types',
    '32-discovery-graph-odsrelated': '3-the-two-graph-edge-types',
    '4-dag-cycle-prevention': '5-dag-validation--cycle-prevention',
    '5-knowledge-graph-purity': '4-knowledge-graph-purity-normative',
    '2-the-4-distinct-subsystems-under-ods': '2-the-5-engine-subsystems-under-ods',
    '3-context-expansion-algorithm': '6-the-context-resolution-algorithm-normative',
    '4-traversal-scoping-max-depth-and-ignore': '6-the-context-resolution-algorithm-normative',
    '5-auxiliary-prompt-fixtures-contextload': 'q2-why-is-a-dedicated-contextload-key-necessary',
    '42-pruning-subtrees-contextignore': '6-the-context-resolution-algorithm-normative',
    '4-the-asset-catalog-odsresources': '5-non-markdown-resources-odsresources',
    '5-code-bindings-odscode': '6-source-code-bindings-odscode',
    '52-the-8-standard-code-roles': '7-the-8-standard-code-roles-reference',
    '53-symbol-based-bindings-why-line-numbers-are-forbidden': '8-why-line-numbers-are-strictly-forbidden',
    '5-custom-profile-catalogs': '7-custom-profiles--profile-definition-files',
    '6-heading-aliases-and-synonym-matching': '6-section-heading-alias-matching',
    '7-reusable-packs': '8-ods-packs-reusable-profile-catalogs',
    '4-diagnostic-message-format': '7-diagnostic-message-presentation',
    '42-odsstatus-required-for-formal-docs': '72-odsstatus',
    '43-odsshare-optional': '74-odsshare',
    '3-progressive-discovery-model': '3-progressive-discovery-cli-workflow',
    '711-profile-definition-metadata': '7-custom-profiles--profile-definition-files',
  };
  const applyHashAlias = (hash) => {
    if (!hash) return hash;
    const id = hash.charAt(0) === '#' ? hash.slice(1) : hash;
    return HASH_ALIASES[id] ? '#' + HASH_ALIASES[id] : (hash.charAt(0) === '#' ? hash : '#' + hash);
  };
  const rewriteMarkdownHref = (href, collectionRoot, currentDir) => {
    if (!href || /^(https?:|mailto:|tel:)/i.test(href)) return null;
    if (href.startsWith('#')) {
      const next = applyHashAlias(href);
      return next === href ? null : next;
    }
    if (href.startsWith('/')) {
      let next = href.replace(/\.mdx?(?=(?:#|$))/i, '');
      next = next.replace(/^\/docs\/guide\//, '/docs/');
      const hi = next.indexOf('#');
      if (hi >= 0) next = next.slice(0, hi) + applyHashAlias(next.slice(hi));
      return next === href ? null : next;
    }
    const hashIndex = href.indexOf('#');
    const pathPart = hashIndex >= 0 ? href.slice(0, hashIndex) : href;
    const hash = applyHashAlias(hashIndex >= 0 ? href.slice(hashIndex) : '');
    if (!pathPart) return hash || null;
    const stripped = pathPart.replace(/\.mdx?$/i, '');
    const segments = currentDir ? currentDir.split('/').filter(Boolean) : [];
    for (const part of stripped.split('/')) {
      if (!part || part === '.') continue;
      if (part === '..') segments.pop();
      else segments.push(part);
    }
    let resolved = segments.join('/');
    if (resolved === 'guides' || resolved.startsWith('guides/')) {
      const name = resolved === 'guides' ? 'README' : resolved.slice('guides/'.length);
      const key = name === 'README' || name === 'intro' ? 'README' : name;
      return (GUIDE_ROUTES[key] || '/docs/learn') + hash;
    }
    if (resolved === 'specs' || resolved.startsWith('specs/')) {
      let rest = resolved === 'specs' ? '' : resolved.slice('specs/'.length);
      if (rest === 'README' || rest === 'learn') rest = 'intro';
      return (rest ? '/spec/ods/' + rest : '/spec') + hash;
    }
    if (resolved === 'README' || resolved.endsWith('/README')) {
      const leaf = collectionRoot === '/docs' ? 'learn' : 'intro';
      resolved = resolved.replace(/README$/, leaf).replace(/\/$/, '');
    }
    if (resolved === 'AGENTS' || resolved === 'agents') {
      return '/spec/ods/intro' + hash;
    }
    if (!resolved) return collectionRoot + hash;
    return collectionRoot + '/' + resolved + hash;
  };
  const syncDocsSidebar = () => {
    document.querySelectorAll('.docs-sidebar-details').forEach((details) => {
      if (window.matchMedia('(max-width: 640px)').matches) details.removeAttribute('open');
      else details.setAttribute('open', '');
    });
  };
  const rewriteDocLinks = () => {
    document.querySelectorAll('.markdown-body[data-doc-root]').forEach((body) => {
      const root = body.getAttribute('data-doc-root') || '';
      const dir = body.getAttribute('data-doc-dir') || '';
      body.querySelectorAll('a[href]').forEach((anchor) => {
        const href = anchor.getAttribute('href');
        const next = rewriteMarkdownHref(href, root, dir);
        if (next) anchor.setAttribute('href', next);
      });
    });
  };
  const enhanceHeadings = () => {
    const body = document.querySelector('.markdown-body[data-doc-path]');
    const docPath = body?.getAttribute('data-doc-path') || location.pathname;
    document.querySelectorAll('.markdown-body h2[id], .markdown-body h3[id], .markdown-body h4[id]').forEach((heading) => {
      if (heading.querySelector('.heading-anchor')) return;
      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = `${docPath}#${heading.id}`;
      anchor.setAttribute('aria-label', `Copy link to ${heading.textContent.trim()}`);
      anchor.textContent = '#';
      heading.appendChild(anchor);
    });
  };
  const headingFromHash = () => {
    const id = decodeURIComponent(location.hash.replace(/^#/, ''));
    if (!id) return null;
    return document.getElementById(id);
  };
  const scrollToHash = () => {
    const target = headingFromHash();
    if (target) target.scrollIntoView({ block: 'start' });
  };
  const setHash = (id, push) => {
    if (window.__odsHashLock && !push) return;
    const url = id ? `${location.pathname}${location.search}#${id}` : `${location.pathname}${location.search}`;
    if (url === `${location.pathname}${location.search}${location.hash}`) return;
    if (push) history.pushState(null, '', url);
    else history.replaceState(null, '', url);
    syncOutlineActive();
  };
  const syncOutlineActive = () => {
    const current = location.hash.replace(/^#/, '');
    document.querySelectorAll('.outline-link').forEach((link) => {
      const href = link.getAttribute('href') || '';
      const hash = href.includes('#') ? href.slice(href.indexOf('#') + 1) : '';
      link.classList.toggle('active', Boolean(current) && hash === current);
    });
  };
  const bindHashNavigation = () => {
    document.querySelectorAll('.outline-link, .heading-anchor').forEach((link) => {
      if (link.dataset.hashBound) return;
      link.dataset.hashBound = 'true';
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href') || '';
        const hashIndex = href.indexOf('#');
        if (hashIndex < 0) return;
        const id = decodeURIComponent(href.slice(hashIndex + 1));
        const path = href.slice(0, hashIndex) || location.pathname;
        const samePage = !path || path === location.pathname;
        if (!samePage) return;
        event.preventDefault();
        setHash(id, true);
        document.getElementById(id)?.scrollIntoView({ block: 'start' });
      });
    });
  };
  const observeSectionHash = () => {
    const headings = [...document.querySelectorAll('.markdown-body h2[id], .markdown-body h3[id], .markdown-body h4[id]')];
    if (!headings.length || !('IntersectionObserver' in window)) return;
    if (window.__odsHeadingObserver) window.__odsHeadingObserver.disconnect();
    const visible = new Map();
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) visible.set(entry.target.id, entry.boundingClientRect.top);
        else visible.delete(entry.target.id);
      });
      const next = [...visible.entries()].sort((a, b) => a[1] - b[1])[0];
      if (next?.[0]) setHash(next[0], false);
    }, { rootMargin: '-20% 0px -65% 0px', threshold: [0, 1] });
    headings.forEach((heading) => observer.observe(heading));
    window.__odsHeadingObserver = observer;
  };
  const initDocsShell = () => {
    syncDocsSidebar();
    rewriteDocLinks();
    enhanceHeadings();
    bindHashNavigation();
    syncOutlineActive();
    if (location.hash) {
      window.__odsHashLock = true;
      scrollToHash();
      window.setTimeout(() => { window.__odsHashLock = false; }, 500);
    }
    observeSectionHash();
  };
  initDocsShell();
  window.addEventListener('resize', syncDocsSidebar, { passive: true });
  window.addEventListener('hashchange', () => {
    syncOutlineActive();
    scrollToHash();
  });
  document.addEventListener('astro:after-swap', initDocsShell);
  document.addEventListener('astro:page-load', initDocsShell);
</script>
