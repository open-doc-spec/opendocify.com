---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
interface Props { activeNav?: string; variant?: 'boxed' | 'fullWidth'; }
const { activeNav = 'home', variant = 'boxed' } = Astro.props;
const items = [{ id: 'home', href: '/', label: 'Home' }, { id: 'features', href: '/features', label: 'Features' }, { id: 'docs', href: '/docs', label: 'Docs' }, { id: 'spec', href: '/spec', label: 'Spec' }, { id: 'examples', href: '/examples', label: 'Examples' }, { id: 'pricing', href: '/pricing', label: 'Pricing' }, { id: 'changelog', href: '/changelog', label: 'Changelog' }];
const container = variant === 'fullWidth' ? 'w-full px-4' : 'container mx-auto max-w-6xl px-4 sm:px-6';
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60"><div class:list={[container, 'flex h-16 items-center justify-between gap-4']}><Logo /><nav class="hidden items-center gap-5 text-sm md:flex" aria-label="Main navigation">{items.map((item) => <a href={item.href} class:list={['transition-colors', activeNav === item.id ? 'font-medium text-foreground' : 'text-foreground/60 hover:text-foreground/80']} aria-current={activeNav === item.id ? 'page' : undefined}>{item.label}</a>)}</nav><div class="flex items-center gap-2"><ThemeToggle /><a href="/docs" class="hidden h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition hover:bg-primary/90 sm:inline-flex">Get started <span class="ml-1">→</span></a><button id="mobile-menu-button" class="inline-flex h-9 w-9 items-center justify-center rounded-md hover:bg-accent md:hidden" aria-expanded="false" aria-label="Toggle navigation menu"><span class="text-lg">☰</span></button></div></div><div id="mobile-menu" class="hidden border-t md:hidden"><nav class:list={[container, 'grid gap-1 py-4']} aria-label="Mobile navigation">{items.map((item) => <a href={item.href} class:list={['rounded-md px-3 py-2 text-base font-medium transition-colors', activeNav === item.id ? 'bg-accent text-accent-foreground' : 'hover:bg-accent hover:text-accent-foreground']} aria-current={activeNav === item.id ? 'page' : undefined}>{item.label}</a>)}<a href="/docs" class="mt-2 rounded-md bg-primary px-3 py-2 text-center text-sm font-medium text-primary-foreground">Get started →</a></nav></div></header>

<script>
  function initMobileMenu() { const button = document.getElementById('mobile-menu-button'); const menu = document.getElementById('mobile-menu'); if (!button || !menu || button.dataset.bound) return; button.dataset.bound = 'true'; button.addEventListener('click', () => { const open = menu.classList.toggle('hidden') === false; button.setAttribute('aria-expanded', String(open)); button.setAttribute('aria-label', open ? 'Close navigation menu' : 'Toggle navigation menu'); }); }
  initMobileMenu(); document.addEventListener('astro:after-swap', initMobileMenu);
</script>
