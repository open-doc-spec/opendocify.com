{
  "name": "@ods/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "NODE_ENV=production astro build --mode production && node -e \"require('node:fs').copyFileSync('dist/sitemap-index.xml','dist/sitemap.xml')\"",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "deploy": "NODE_ENV=production npm run build && firebase deploy --only hosting --project prod-ods-260726",
    "sync:ods-spec": "node scripts/sync-ods-spec.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@astrojs/check": "^0.9.7",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1"
  }
